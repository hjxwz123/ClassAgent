APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://class_agent:replace-password@127.0.0.1:3306/class_agent?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false
EXTERNAL_AI_MODE=strict
EXTERNAL_STORAGE_MODE=auto
EXTERNAL_SERVICE_TIMEOUT_SECONDS=300
MATERIAL_PROCESSING_WORKER_COUNT=4
DOC_PARSER_MAX_CONCURRENCY=2
MATERIAL_AI_MAX_CONCURRENCY=6
TTS_MAX_CONCURRENCY=1
MATERIAL_PROCESSING_STALE_MINUTES=10
MATERIAL_PROCESSING_WATCHDOG_INTERVAL_SECONDS=30
PUBLIC_BASE_URL=https://your-domain.example.com
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIR=storage/vectors/chroma
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=classagent
QDRANT_TIMEOUT_SECONDS=10
EMBEDDING_DIMENSION=384
ADMIN_DEFAULT_EMAIL=admin@classagent.com
ADMIN_DEFAULT_PASSWORD=replace-admin-password
ADMIN_DEFAULT_NAME=系统管理员
