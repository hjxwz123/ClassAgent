APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://class_agent:replace-password@127.0.0.1:3306/class_agent?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false
EXTERNAL_AI_MODE=strict
EXTERNAL_STORAGE_MODE=auto
EXTERNAL_SERVICE_TIMEOUT_SECONDS=30
PUBLIC_BASE_URL=https://your-domain.example.com
CHROMA_PERSIST_DIR=storage/vectors/chroma
EMBEDDING_DIMENSION=384
ADMIN_DEFAULT_EMAIL=admin@classagent.com
ADMIN_DEFAULT_PASSWORD=replace-admin-password
ADMIN_DEFAULT_NAME=系统管理员
