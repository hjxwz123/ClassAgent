APP_ENV=production
SECRET_KEY=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
DATABASE_URL=mysql+pymysql://class_agent:REPLACE_WITH_STRONG_DB_PASSWORD@127.0.0.1:3306/class_agent?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CORS_ALLOW_ORIGINS=https://classagent.example.school
CORS_ALLOW_CREDENTIALS=false
OPENAPI_ENABLED=false
SECURITY_HEADERS_ENABLED=true
UPLOAD_AV_SCAN_ENABLED=true
UPLOAD_AV_SCAN_COMMAND=clamdscan --no-summary {file}
UPLOAD_AV_SCAN_TIMEOUT_SECONDS=30
UPLOAD_IMAGE_REENCODE_ENABLED=true
UPLOAD_IMAGE_MAX_PIXELS=20000000
UPLOAD_IMAGE_MAX_WIDTH=8000
UPLOAD_IMAGE_MAX_HEIGHT=8000
UPLOAD_IMAGE_REVIEW_ENABLED=true
UPLOAD_IMAGE_REVIEW_COMMAND=/usr/local/bin/classagent-image-review {file}
UPLOAD_IMAGE_REVIEW_TIMEOUT_SECONDS=30
EXTERNAL_AI_MODE=strict
EXTERNAL_STORAGE_MODE=auto
EXTERNAL_SERVICE_TIMEOUT_SECONDS=300
MATERIAL_PROCESSING_WORKER_COUNT=4
DOC_PARSER_MAX_CONCURRENCY=2
MATERIAL_AI_MAX_CONCURRENCY=6
TTS_MAX_CONCURRENCY=1
MATERIAL_PROCESSING_STALE_MINUTES=10
MATERIAL_PROCESSING_WATCHDOG_INTERVAL_SECONDS=30
PUBLIC_BASE_URL=https://classagent.example.school
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIR=storage/vectors/chroma
QDRANT_URL=http://127.0.0.1:6333
# Without a standalone Qdrant service, use a local embedded store:
# QDRANT_URL=local:storage/vectors/qdrant
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=classagent
QDRANT_TIMEOUT_SECONDS=10
EMBEDDING_DIMENSION=384
ADMIN_DEFAULT_EMAIL=admin@classagent.com
ADMIN_DEFAULT_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ADMIN_DEFAULT_NAME=系统管理员
