@startuml
!include plantuml-style.iuml
title 错题、薄弱点与学习计划详细类图（清晰版）
top to bottom direction
hide methods

package "课程与用户" {
  class "用户 User" as User <<entity>> {
    id
    role
    nickname
  }

  class "课程 Course" as Course <<entity>> {
    id
    name
    status
  }

  class "课程成员 CourseMembership" as Membership <<entity>> {
    courseId
    userId
    role
  }
}

package "薄弱诊断" {
  class "知识点 KnowledgePoint" as Point <<entity>> {
    courseId
    name
  }

  class "学习信号 StudentLearningSignal" as Signal <<entity>> {
    userId
    knowledgePointId
    score
    confidence
  }

  class "问答记录 QARecord" as QA <<entity>> {
    userId
    courseId
    question
  }

  class "学习进度 LearningProgress" as Progress <<entity>> {
    lessonId
    userId
    progressPercent
  }
}

package "错题闭环" {
  class "测验题目 QuizQuestion" as Question <<entity>> {
    quizId
    knowledgePointId
    stem
  }

  class "作答记录 QuizAttempt" as Attempt <<entity>> {
    quizId
    userId
    score
  }

  class "错题 WrongQuestion" as Wrong <<entity>> {
    userId
    questionId
    wrongCount
    isResolved
  }
}

package "学习计划" {
  class "学习计划 StudyPlan" as Plan <<entity>> {
    userId
    courseId
    goal
    status
  }

  class "计划任务 StudyPlanTask" as PlanTask <<entity>> {
    planId
    taskDate
    taskType
    status
  }

  class "学习打卡 StudyCheckin" as Checkin <<entity>> {
    taskId
    userId
    checkedInAt
  }
}

Course "1" o-- "0..*" Membership : 成员
User "1" -- "0..*" Membership : 加入
Point "1" -- "0..*" Signal : 行为证据
QA "0..*" --> "0..*" Signal : 问答信号
Progress "0..*" --> "0..*" Signal : 进度信号
Point "1" -- "0..*" Wrong : 薄弱归因
Question "1" -- "0..*" Wrong : 错题来源
Attempt "0..1" -- "0..*" Wrong : 最近尝试
Plan "1" *-- "1..*" PlanTask : 任务
PlanTask "1" *-- "0..1" Checkin : 打卡

@enduml
