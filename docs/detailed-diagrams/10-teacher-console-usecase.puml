@startuml
!include plantuml-style.iuml
title 教师工作台详细用例图（清晰版）
left to right direction

actor "教师" as Teacher
actor "学生" as Student
actor "CSV 下载客户端" as CSVClient
actor "对象存储服务" as Storage
actor "大模型服务" as LLM

rectangle "教师工作台" {
  usecase "课程内容管理" as UCCourseOps
  usecase "学生与教学分析" as UCStudentAnalysisOps
  usecase "教师个人中心" as UCProfileOps

  package "课程与内容" {
    usecase "工作台与课程主页\nGET /teacher/dashboard\nGET /teacher/courses*" as UCCourseHome
    usecase "资料汇总与资料管理\nGET /teacher/courses/{id}/materials/summary\n/materials 系列接口" as UCMaterials
    usecase "章节管理\nPATCH|DELETE /teacher/courses/{id}/chapters/{id}" as UCChapters
    usecase "课时管理\nPATCH|POST|DELETE /teacher/lessons/{id}" as UCLessons
  }

  package "学生与分析" {
    usecase "学生管理\nGET|DELETE /teacher/courses/{id}/students*" as UCStudents
    usecase "提醒学生\nPOST /teacher/courses/{id}/students/{id}/remind" as UCRemind
    usecase "教学分析\nGET /teacher/courses/{id}/analysis" as UCAnalysis
    usecase "导出 CSV\n/students/export 或 /analysis/export" as UCExport
    usecase "生成教学建议" as UCSuggestion
  }

  package "个人中心" {
    usecase "教师个人中心\nGET|PATCH|POST /teacher/profile*" as UCProfile
    usecase "通知设置与已读\nPUT /teacher/profile/notifications\nPOST /teacher/notifications/read" as UCNotice
  }
}

Teacher --> UCCourseOps
Teacher --> UCStudentAnalysisOps
Teacher --> UCProfileOps
Student --> UCRemind
CSVClient --> UCExport
Storage --> UCProfile
LLM --> UCSuggestion

UCStudents ..> UCRemind : <<extend>>
UCAnalysis ..> UCSuggestion : <<include>>
UCExport ..> UCStudents : <<extend>>
UCExport ..> UCAnalysis : <<extend>>
UCProfile ..> UCNotice : <<include>>

@enduml
