@startuml
!include plantuml-style.iuml
title 学生工作台详细用例图（清晰版）
left to right direction

actor "学生" as Student
actor "对象存储服务" as Storage
actor "Redis 缓存" as Cache
actor "大模型服务" as LLM

rectangle "学生工作台" {
  package "学习台" {
    usecase "查看学习台\nGET /student/dashboard" as UCDashboard
    usecase "生成 / 刷新今日推荐" as UCRecommend
  }

  package "课程" {
    usecase "查看我的课程\nGET /student/courses" as UCCourses
    usecase "课程码预览\nGET /student/courses/preview" as UCPreview
    usecase "加入课程\nPOST /courses/join" as UCJoin
    usecase "查看课程主页\nGET /student/courses/{course_id}/home" as UCHome
  }

  package "学习记录与个人中心" {
    usecase "读取 / 保存页笔记\nGET|PUT /student/pages/{page_id}/note" as UCNote
    usecase "查看 / 更新个人资料\nGET|PATCH /student/profile" as UCProfile
    usecase "上传头像\nPOST /student/profile/avatar" as UCAvatar
    usecase "通知列表 / 偏好 / 已读\nGET|PUT|POST /student/notifications*" as UCNotice
  }
}

Student --> UCDashboard
Student --> UCCourses
Student --> UCHome
Student --> UCNote
Student --> UCProfile
Storage --> UCAvatar
Cache --> UCRecommend
LLM --> UCRecommend

UCDashboard ..> UCRecommend : <<include>>
UCPreview ..> UCJoin : <<extend>>
UCAvatar ..> UCProfile : <<extend>>
UCProfile ..> UCNotice : <<include>>

note bottom of UCDashboard
  聚合课程、今日任务、继续学习、
  学习统计、动态、通知和 AI 推荐。
end note

@enduml
