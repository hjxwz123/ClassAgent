@startuml
!include plantuml-style.iuml
title 课程与成员详细用例图（清晰版）
left to right direction

actor "教师" as Teacher
actor "学生" as Student
actor "管理员" as Admin
actor "对象存储服务" as Storage

rectangle "课程与成员" {
  usecase "教师课程管理" as UCTeacherCourse
  usecase "学生选课与学习入口" as UCStudentCourse
  usecase "管理员课程治理" as UCAdminCourse

  package "教师侧明细" {
    usecase "创建课程\nPOST /courses" as UCCreate
    usecase "维护课程信息\nPATCH /courses/{course_id}" as UCUpdate
    usecase "上传课程封面\nPOST /courses/{course_id}/cover" as UCCover
    usecase "章节管理\nPOST /courses/{course_id}/chapters" as UCChapter
    usecase "成员列表\nGET /courses/{course_id}/members" as UCMembers
  }

  package "学生侧明细" {
    usecase "查看已加入课程\nGET /courses/enrolled" as UCEnrolled
    usecase "课程码加入\nPOST /courses/join" as UCJoin
    usecase "退出课程\nPOST /courses/{course_id}/leave" as UCLeave
    usecase "查看课程详情\nGET /courses/{course_id}" as UCDetail
    usecase "校验课程码与成员关系" as UCValidate
  }

  package "治理明细" {
    usecase "查看授课课程\nGET /courses/teaching" as UCTeaching
    usecase "启用 / 停用课程\nPOST /courses/{course_id}/activate|deactivate" as UCStatus
  }
}

Teacher --> UCTeacherCourse
Student --> UCStudentCourse
Admin --> UCAdminCourse
Storage --> UCCover

UCJoin ..> UCValidate : <<include>>
UCLeave ..> UCValidate : <<include>>
UCDetail ..> UCValidate : <<include>>
UCStatus ..> UCUpdate : <<extend>>

@enduml
