@startuml
!include plantuml-style.iuml
title 错题、薄弱点与学习计划详细用例图（清晰版）
left to right direction

actor "学生" as Student
actor "教师" as Teacher
actor "异步任务 Worker" as Worker
actor "大模型服务" as LLM

rectangle "错题、薄弱点与学习计划" {
  usecase "学生学习支持" as UCStudentSupport
  usecase "教师薄弱点教学支持" as UCTeacherSupport

  package "错题本" {
    usecase "查看错题本\nGET /learning/wrong-questions" as UCWrong
    usecase "生成错题重练\nPOST /learning/wrong-questions/practice" as UCPractice
    usecase "复制错题为练习测验" as UCCopyQuiz
  }

  package "薄弱点" {
    usecase "查看个人薄弱点\nGET /learning/weak-points" as UCWeak
    usecase "聚合错题与学习信号" as UCAggregate
    usecase "教师查看班级薄弱点\nGET /learning/teacher/weak-quizzes" as UCTeacherWeak
    usecase "按薄弱点生成专项测验" as UCWeakQuiz
  }

  package "学习计划" {
    usecase "创建学习计划\nPOST /learning/plans" as UCPlan
    usecase "生成计划任务" as UCPlanTask
    usecase "查看计划 / 任务\nGET /learning/plans*" as UCPlanQuery
    usecase "任务打卡\nPOST /learning/tasks/{task_id}/checkin" as UCCheckin
    usecase "查看学习记录\nGET /learning/records" as UCRecords
  }
}

Student --> UCStudentSupport
Teacher --> UCTeacherSupport
Worker --> UCCopyQuiz
LLM --> UCPlanTask

UCPractice ..> UCCopyQuiz : <<include>>
UCWeak ..> UCAggregate : <<include>>
UCTeacherWeak ..> UCAggregate : <<include>>
UCPlan ..> UCPlanTask : <<include>>

@enduml
