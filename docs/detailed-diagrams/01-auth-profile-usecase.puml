@startuml
!include plantuml-style.iuml
title 认证与个人中心详细用例图（清晰版）
left to right direction

actor "访客" as Guest
actor "平台用户" as User
actor "学生" as Student
actor "教师" as Teacher
actor "管理员" as Admin
actor "SMTP 邮件服务" as Mail
actor "对象存储服务" as Storage

Student --|> User
Teacher --|> User
Admin --|> User

rectangle "认证与个人中心" {
  usecase "公开认证" as UCAuth
  usecase "通用账号管理" as UCAccountMgmt
  usecase "角色个人中心" as UCRoleProfile

  package "公开认证明细" {
    usecase "学生注册\nPOST /auth/register" as UCRegister
    usecase "账号登录\nPOST /auth/login" as UCLogin
    usecase "找回 / 重置密码\nPOST /auth/password/reset/*" as UCReset
    usecase "生成令牌并记录登录" as UCTokenLog
    usecase "发送验证码邮件" as UCSendCode
  }

  package "账号明细" {
    usecase "查看 / 修改当前账号\nGET|PATCH /auth/me" as UCAccount
    usecase "修改登录密码\nPOST /auth/me/password" as UCPassword
    usecase "记录账号操作日志" as UCOperationLog
  }

  package "个人中心明细" {
    usecase "学生个人中心\nGET|PATCH /student/profile" as UCStudentProfile
    usecase "教师个人中心\nGET|PATCH /teacher/profile" as UCTeacherProfile
    usecase "上传头像\nPOST /student|teacher/profile/avatar" as UCAvatar
    usecase "通知偏好与已读\nPUT|POST /notifications" as UCNotice
  }
}

Guest --> UCAuth
User --> UCAccountMgmt
Student --> UCRoleProfile
Teacher --> UCRoleProfile
Mail --> UCAuth
Storage --> UCRoleProfile

UCLogin ..> UCTokenLog : <<include>>
UCReset ..> UCSendCode : <<include>>
UCAvatar ..> UCStudentProfile : <<extend>>
UCAvatar ..> UCTeacherProfile : <<extend>>
UCAccount ..> UCOperationLog : <<include>>

@enduml
