@startuml
!include plantuml-style.iuml
title 学生工作台详细类图（清晰版）
top to bottom direction
hide methods

package "学生身份" {
  class "用户 User" as User <<entity>> {
    id
    role
    nickname
    avatarUrl
  }

  class "学生 Student" as Student <<role>> {
    studentNo
    school
  }

  class "教师 Teacher" as Teacher <<role>> {
    employeeNo
  }

  class "用户偏好 UserPreference" as Preference <<entity>> {
    userId
    preferenceKey
    preferenceValue
  }
}

package "我的课程" {
  class "课程 Course" as Course <<entity>> {
    id
    courseCode
    teacherId
    status
  }

  class "课程成员 CourseMembership" as Membership <<entity>> {
    courseId
    userId
    joinedAt
  }

  class "课程资料 CourseMaterial" as Material <<entity>> {
    courseId
    title
    parseStatus
  }
}

package "学习内容" {
  class "课时 Lesson" as Lesson <<entity>> {
    courseId
    title
    status
  }

  class "课时页 LessonPage" as Page <<entity>> {
    lessonId
    pageNumber
    pageText
  }

  class "页笔记 PageNote" as Note <<entity>> {
    userId
    lessonPageId
    content
  }

  class "学习进度 LearningProgress" as Progress <<entity>> {
    lessonId
    userId
    progressPercent
  }
}

package "学习台聚合" {
  class "测验 Quiz" as Quiz <<entity>> {
    courseId
    title
    status
  }

  class "问答记录 QARecord" as QA <<entity>> {
    userId
    courseId
    question
  }

  class "错题 WrongQuestion" as Wrong <<entity>> {
    userId
    courseId
    wrongCount
  }

  class "计划任务 StudyPlanTask" as PlanTask <<entity>> {
    planId
    taskDate
    status
  }
}

User <|-- Student
User <|-- Teacher
Course "1" o-- "0..*" Membership : 成员
Course "1" o-- "0..*" Material : 资料
Lesson "1" *-- "1..*" Page : 页面
Page "1" -- "0..*" Note : 笔记
Lesson "1" -- "0..*" Progress : 进度

@enduml
