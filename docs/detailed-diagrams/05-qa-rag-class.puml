@startuml
!include plantuml-style.iuml
title RAG 问答详细类图（清晰版）
top to bottom direction
hide methods

package "访问范围" {
  class "用户 User" as User <<entity>> {
    id
    role
    nickname
  }

  class "课程 Course" as Course <<entity>> {
    id
    allowGeneralAiAnswer
  }

  class "课程成员 CourseMembership" as Membership <<entity>> {
    courseId
    userId
  }
}

package "知识上下文" {
  class "课时 Lesson" as Lesson <<entity>> {
    courseId
    title
  }

  class "课时页 LessonPage" as Page <<entity>> {
    lessonId
    pageNumber
    pageText
    scriptText
  }

  class "知识块 KnowledgeChunk" as Chunk <<entity>> {
    courseId
    materialId
    lessonPageId
    title
    content
    embedding
  }

  class "教学产物 PedagogyArtifact" as Artifact <<entity>> {
    lessonPageId
    artifactType
    title
    content
  }
}

package "问答过程" {
  class "问答会话 QAConversation" as Conversation <<entity>> {
    courseId
    userId
    title
  }

  class "问答记录 QARecord" as Record <<entity>> {
    conversationId
    courseId
    userId
    lessonPageId
    question
    answer
    sources
    feedback
  }

  class "问答附件 QAAttachment" as Attachment <<entity>> {
    recordId
    fileType
    storagePath
    ocrText
  }
}

package "学习反馈" {
  class "学习信号 StudentLearningSignal" as Signal <<entity>> {
    userId
    courseId
    knowledgePointId
    sourceType
    score
  }

  class "AI 用量日志 AIUsageLog" as Usage <<entity>> {
    module
    provider
    modelName
    promptTokens
    success
  }
}

Course "1" o-- "0..*" Membership : 成员
User "1" -- "0..*" Membership : 加入
Lesson "1" *-- "1..*" Page : 页面
Page "0..1" -- "0..*" Chunk : 来源页
Page "1" -- "0..*" Artifact : 教学对象
Conversation "1" *-- "1..*" Record : 记录
Record "1" o-- "0..*" Attachment : 附件

@enduml
