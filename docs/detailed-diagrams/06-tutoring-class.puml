@startuml
!include plantuml-style.iuml
title 题目辅导详细类图（清晰版）
top to bottom direction
hide methods

package "课程访问" {
  class "用户 User" as User <<entity>> {
    id
    role
  }

  class "课程 Course" as Course <<entity>> {
    id
    allowGeneralAiAnswer
  }

  class "课程成员 CourseMembership" as Membership <<entity>> {
    courseId
    userId
  }
}

package "题目输入" {
  class "题目记录 ProblemRecord" as Problem <<entity>> {
    courseId
    userId
    sourceType
    rawText
    correctedText
    knowledgePoints
    commonMistakes
  }

  class "题目图片 ProblemImage" as ProblemImage <<entity>> {
    problemId
    imagePath
    previewUrl
  }

  class "OCR 结果 OCRResult" as OcrResult <<value>> {
    problemId
    ocrText
    confidence
  }
}

package "辅导输出" {
  class "分级辅导 ProblemGuidance" as Guidance <<entity>> {
    problemId
    level
    content
    similarQuestions
  }

  class "AI 用量日志 AIUsageLog" as Usage <<entity>> {
    module
    promptTokens
    completionTokens
    success
  }
}

package "检索上下文" {
  class "知识块 KnowledgeChunk" as Chunk <<entity>> {
    courseId
    title
    content
    embedding
  }

  class "教学产物 PedagogyArtifact" as Artifact <<entity>> {
    courseId
    artifactType
    content
  }
}

Course "1" o-- "0..*" Membership : 成员
User "1" -- "0..*" Membership : 加入
Problem "1" o-- "0..1" ProblemImage : 题图
Problem "1" o-- "0..1" OcrResult : 识别文本

@enduml
