@startuml
title 配置、日志、监控与备份概念类图
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Noto Sans CJK SC
skinparam titleFontName Noto Sans CJK SC
skinparam classFontName Noto Sans CJK SC
skinparam classAttributeFontName Noto Sans CJK SC
hide methods

abstract class "用户" as User {
  id
  email
  role
  status
}

class "管理员" as Admin
class "课程" as Course {
  name
  courseCode
  status
}

abstract class "系统配置项" as ConfigItem {
  scope
  keyOrName
  value
  enabled
}

class "模型配置" as ModelConfig {
  provider
  modelName
  purpose
  endpoint
  isDefault
}

class "外部服务配置" as ServiceConfig {
  serviceType
  provider
  name
  isEnabled
}

class "系统参数" as SystemSetting {
  category
  settingKey
  settingValue
  description
}

abstract class "日志记录" as LogRecord {
  createdAt
  detail
}

class "操作日志" as OperationLog {
  action
  targetType
  targetId
}

class "登录日志" as LoginLog {
  loginIp
  userAgent
  success
}

class "API 请求日志" as ApiRequestLog {
  requestId
  method
  path
  statusCode
  durationMs
}

class "AI 用量日志" as AIUsageLog {
  module
  provider
  modelName
  estimatedCost
  success
}

class "异步任务日志" as AsyncTaskLog {
  taskName
  targetType
  targetId
  status
}

class "系统错误日志" as SystemErrorLog {
  level
  source
  message
}

class "备份记录" as BackupRecord {
  filePath
  status
  detail
}

class "课程资料" as CourseMaterial {
  title
  parseStatus
  vectorStatus
}

class "测验" as Quiz {
  title
  status
}

User <|-- Admin
ConfigItem <|-- ModelConfig
ConfigItem <|-- ServiceConfig
ConfigItem <|-- SystemSetting
LogRecord <|-- OperationLog
LogRecord <|-- LoginLog
LogRecord <|-- ApiRequestLog
LogRecord <|-- AIUsageLog
LogRecord <|-- AsyncTaskLog
LogRecord <|-- SystemErrorLog
LogRecord <|-- BackupRecord

Admin "1" -- "0..*" ModelConfig : 维护
Admin "1" -- "0..*" ServiceConfig : 维护
Admin "1" -- "0..*" SystemSetting : 维护
Admin "1" -- "0..*" Course : 管理 / 接管
Admin "0..1" -- "0..*" BackupRecord : 触发
Admin "1" -- "0..*" SystemErrorLog : 处理

User "0..1" -- "0..*" OperationLog : 操作
User "1" -- "0..*" LoginLog : 登录
User "0..1" -- "0..*" ApiRequestLog : 请求
User "0..1" -- "0..*" AIUsageLog : 调用 AI
Course "0..1" -- "0..*" AIUsageLog : 课程上下文
Course "1" *-- "0..*" CourseMaterial : 资料
Course "1" *-- "0..*" Quiz : 测验

ModelConfig ..> AIUsageLog : 记录模型用量
ModelConfig ..> Quiz : 支持测验生成
ServiceConfig ..> CourseMaterial : 支持存储 / 解析
AsyncTaskLog ..> CourseMaterial : 资料处理任务
AsyncTaskLog ..> Quiz : 测验生成任务
SystemErrorLog ..> OperationLog : 关联排障
BackupRecord ..> Course : 备份业务数据

@enduml
