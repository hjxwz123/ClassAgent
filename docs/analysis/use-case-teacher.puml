@startuml
title 教师端完整用例图
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Noto Sans CJK SC
skinparam titleFontName Noto Sans CJK SC
skinparam actorFontName Noto Sans CJK SC
skinparam usecaseFontName Noto Sans CJK SC
skinparam packageFontName Noto Sans CJK SC

actor "教师" as Teacher
actor "学生" as Student
actor "外部大模型服务" as LLM
actor "文档解析服务" as DocParser
actor "Embedding / 向量库" as VectorService
actor "TTS 服务" as TTS
actor "对象存储服务" as OSS
actor "通知服务" as Notify

rectangle "教师工作台" {
  package "课程建设" {
    usecase "查看教师工作台" as UCDashboard
    usecase "查看教师课程列表" as UCCourseList
    usecase "创建课程" as UCCreateCourse
    usecase "修改课程 / 封面" as UCUpdateCourse
    usecase "删除 / 停用 / 激活课程" as UCDisableCourse
    usecase "查看课程主页" as UCCourseHome
    usecase "创建章节" as UCCreateChapter
    usecase "更新 / 删除章节" as UCManageChapter
  }

  package "资料与课时生产" {
    usecase "上传课程资料" as UCUploadMaterial
    usecase "查看资料列表 / 详情 / 原文" as UCViewMaterial
    usecase "修改 / 删除资料" as UCManageMaterial
    usecase "重新处理资料" as UCReprocess
    usecase "查看资料统计摘要" as UCMaterialSummary
    usecase "解析资料" as UCDocParse
    usecase "生成课时页" as UCLessonBuild
    usecase "生成 / 审核 / 修改讲稿" as UCScript
    usecase "生成音频与字幕" as UCAudio
    usecase "构建知识块与向量索引" as UCIndex
    usecase "查看课时列表 / 详情" as UCLessonView
    usecase "发布 / 下线课时" as UCPublishLesson
    usecase "复制 / 修改 / 删除课时" as UCManageLesson
  }

  package "测验与弱点练习" {
    usecase "生成课程测验" as UCGenerateQuiz
    usecase "编辑测验内容" as UCEditQuiz
    usecase "发布测验" as UCPublishQuiz
    usecase "查看测验详情" as UCQuizDetail
    usecase "按薄弱点生成测验" as UCWeakQuiz
    usecase "查看薄弱点测验作答" as UCWeakAttempt
    usecase "轮询生成任务" as UCTask
  }

  package "学生与学情" {
    usecase "查看学生列表" as UCStudentList
    usecase "查看学生详情" as UCStudentDetail
    usecase "导出学生名单" as UCExportStudents
    usecase "提醒学生" as UCRemind
    usecase "移除学生" as UCRemoveStudent
    usecase "查看课程教学分析" as UCAnalysis
    usecase "导出教学分析" as UCExportAnalysis
    usecase "查看高频问题" as UCHighFreqQA
    usecase "查看薄弱点分布" as UCWeakPoint
    usecase "查看成绩分布 / 完成率" as UCScoreProgress
  }

  package "教师个人中心" {
    usecase "维护教师资料" as UCProfile
    usecase "上传头像" as UCAvatar
    usecase "维护通知偏好" as UCNotice
    usecase "标记通知已读" as UCNoticeRead
  }
}

Teacher --> UCDashboard
Teacher --> UCCourseList
Teacher --> UCCreateCourse
Teacher --> UCUpdateCourse
Teacher --> UCDisableCourse
Teacher --> UCCourseHome
Teacher --> UCCreateChapter
Teacher --> UCManageChapter
Teacher --> UCUploadMaterial
Teacher --> UCViewMaterial
Teacher --> UCManageMaterial
Teacher --> UCReprocess
Teacher --> UCMaterialSummary
Teacher --> UCLessonView
Teacher --> UCPublishLesson
Teacher --> UCManageLesson
Teacher --> UCGenerateQuiz
Teacher --> UCEditQuiz
Teacher --> UCPublishQuiz
Teacher --> UCQuizDetail
Teacher --> UCWeakQuiz
Teacher --> UCWeakAttempt
Teacher --> UCStudentList
Teacher --> UCStudentDetail
Teacher --> UCExportStudents
Teacher --> UCRemind
Teacher --> UCRemoveStudent
Teacher --> UCAnalysis
Teacher --> UCExportAnalysis
Teacher --> UCProfile
Teacher --> UCAvatar
Teacher --> UCNotice
Teacher --> UCNoticeRead

Student --> UCRemind
Notify --> UCRemind
Notify --> UCNotice
OSS --> UCUploadMaterial
DocParser --> UCDocParse
VectorService --> UCIndex
LLM --> UCScript
LLM --> UCGenerateQuiz
LLM --> UCWeakQuiz
LLM --> UCAnalysis
TTS --> UCAudio

UCCourseHome ..> UCMaterialSummary : <<include>>
UCCourseHome ..> UCLessonView : <<include>>
UCUploadMaterial ..> UCDocParse : <<include>>
UCUploadMaterial ..> UCLessonBuild : <<include>>
UCUploadMaterial ..> UCScript : <<include>>
UCUploadMaterial ..> UCAudio : <<include>>
UCUploadMaterial ..> UCIndex : <<include>>
UCReprocess ..> UCDocParse : <<include>>
UCReprocess ..> UCIndex : <<include>>
UCScript ..> UCAudio : <<include>>
UCPublishLesson ..> UCScript : <<extend>>
UCPublishQuiz ..> UCEditQuiz : <<extend>>
UCWeakQuiz ..> UCWeakPoint : <<include>>
UCWeakQuiz ..> UCTask : <<include>>
UCGenerateQuiz ..> UCTask : <<include>>
UCAnalysis ..> UCHighFreqQA : <<include>>
UCAnalysis ..> UCWeakPoint : <<include>>
UCAnalysis ..> UCScoreProgress : <<include>>
UCStudentDetail ..> UCWeakPoint : <<include>>
UCStudentDetail ..> UCScoreProgress : <<include>>

@enduml
