@startuml
title 测验、错题、薄弱点与学习计划概念类图
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Noto Sans CJK SC
skinparam titleFontName Noto Sans CJK SC
skinparam classFontName Noto Sans CJK SC
skinparam classAttributeFontName Noto Sans CJK SC
hide methods

abstract class "用户" as User {
  id
  role
  nickname
}

class "学生" as Student
class "教师" as Teacher
class "课程" as Course {
  name
  courseCode
}

class "章节" as Chapter {
  title
  orderIndex
}

class "知识点" as KnowledgePoint {
  name
  contentByLevel
}

class "测验" as Quiz {
  title
  quizType
  status
  totalScore
}

class "测验题目" as QuizQuestion {
  questionType
  stem
  options
  referenceAnswer
  explanation
  score
}

class "测验作答" as QuizAttempt {
  score
  totalScore
  accuracy
  aiFeedback
  submittedAt
}

class "作答明细" as QuizAnswer {
  userAnswer
  isCorrect
  score
  feedback
}

class "错题" as WrongQuestion {
  wrongCount
  isResolved
  lastWrongAt
  lastCorrectAt
}

class "学习信号" as StudentLearningSignal {
  sourceType
  intent
  score
  confidence
}

class "题目记录" as ProblemRecord {
  sourceType
  rawText
  ocrText
  correctedText
}

class "分级辅导" as ProblemGuidance {
  level
  content
}

class "学习计划" as StudyPlan {
  title
  goal
  availableDays
  dailyMinutes
  status
}

class "计划任务" as StudyPlanTask {
  title
  taskDate
  taskType
  estimatedMinutes
  status
}

class "学习打卡" as StudyCheckin {
  notes
  checkedInAt
}

User <|-- Student
User <|-- Teacher

Course "1" *-- "0..*" Chapter : 包含章节
Course "1" *-- "0..*" KnowledgePoint : 知识体系
Chapter "0..1" -- "0..*" KnowledgePoint : 章节知识点
Course "1" *-- "0..*" Quiz : 测验集合
Chapter "0..1" -- "0..*" Quiz : 章节测验
Teacher "1" -- "0..*" Quiz : 创建 / 发布
Quiz "1" *-- "1..*" QuizQuestion : 题目
QuizQuestion "*" --> "0..1" KnowledgePoint : 考查

Student "1" -- "0..*" QuizAttempt : 提交
QuizAttempt "*" -- "1" Quiz : 针对测验
QuizAttempt "1" *-- "1..*" QuizAnswer : 答案
QuizAnswer "*" -- "1" QuizQuestion : 对应题目
QuizAnswer "0..*" --> "0..1" WrongQuestion : 错误生成
Student "1" -- "0..*" WrongQuestion : 错题本
WrongQuestion "*" -- "1" QuizQuestion : 来源题目
WrongQuestion "*" --> "0..1" KnowledgePoint : 薄弱知识点

Student "1" -- "0..*" ProblemRecord : 题目辅导记录
ProblemRecord "1" *-- "0..*" ProblemGuidance : 分级辅导
ProblemRecord "*" --> "0..*" KnowledgePoint : 关联知识点

WrongQuestion "0..*" --> "0..*" StudentLearningSignal : 强化信号
ProblemRecord "0..*" --> "0..*" StudentLearningSignal : 辅导信号
QuizAnswer "0..*" --> "0..*" StudentLearningSignal : 作答信号
StudentLearningSignal "*" --> "1" KnowledgePoint : 指向知识点
StudentLearningSignal "*" -- "1" Course : 所属课程

Student "1" -- "0..*" StudyPlan : 学习计划
Course "1" -- "0..*" StudyPlan : 计划课程
StudyPlan "1" *-- "1..*" StudyPlanTask : 计划任务
StudyPlanTask "*" --> "0..*" KnowledgePoint : 练习目标
StudyPlanTask "1" *-- "0..*" StudyCheckin : 打卡
Student "1" -- "0..*" StudyCheckin : 完成

@enduml
