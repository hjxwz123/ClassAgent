@startuml
title 管理员端完整用例图
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Noto Sans CJK SC
skinparam titleFontName Noto Sans CJK SC
skinparam actorFontName Noto Sans CJK SC
skinparam usecaseFontName Noto Sans CJK SC
skinparam packageFontName Noto Sans CJK SC

actor "管理员" as Admin
actor "外部大模型服务" as LLM
actor "Embedding / 向量库" as VectorService
actor "文档解析服务" as DocParser
actor "OCR 服务" as OCR
actor "TTS 服务" as TTS
actor "对象存储服务" as OSS
actor "邮件服务" as Mail
actor "数据库 / Redis / Celery" as Runtime

rectangle "管理员后台" {
  package "总览与健康" {
    usecase "查看管理仪表盘" as UCDashboard
    usecase "查看服务健康" as UCHealth
    usecase "一键测试全部服务" as UCTestAll
    usecase "查看系统监控总览" as UCMonitoring
    usecase "查看监控时序数据" as UCTimeseries
  }

  package "用户管理" {
    usecase "查看用户统计" as UCUserStats
    usecase "查询用户列表" as UCUserList
    usecase "查看用户详情" as UCUserDetail
    usecase "创建教师 / 学生 / 管理员" as UCCreateUser
    usecase "修改用户状态 / 角色" as UCUpdateUser
    usecase "重置用户密码" as UCResetUserPassword
    usecase "删除用户" as UCDeleteUser
  }

  package "课程与资料监管" {
    usecase "查看课程统计" as UCCourseStats
    usecase "查询课程列表" as UCCourseList
    usecase "查看课程详情" as UCCourseDetail
    usecase "接管课程" as UCTakeoverCourse
    usecase "启用 / 停用课程" as UCActivateCourse
    usecase "查看资料统计" as UCMaterialStats
    usecase "查询资料列表" as UCMaterialList
    usecase "删除违规资料" as UCDeleteMaterial
  }

  package "模型与外部服务配置" {
    usecase "查看模型配置" as UCModelList
    usecase "保存模型配置" as UCSaveModel
    usecase "测试模型配置" as UCTestModel
    usecase "删除模型配置" as UCDeleteModel
    usecase "查看模型用量" as UCModelUsage
    usecase "查看服务配置" as UCServiceList
    usecase "保存 OSS / OCR / TTS / 邮件 / 文档解析配置" as UCSaveService
    usecase "测试服务配置" as UCTestService
    usecase "删除服务配置" as UCDeleteService
  }

  package "系统参数、日志与备份" {
    usecase "查看系统参数" as UCSettingList
    usecase "更新系统参数" as UCUpdateSetting
    usecase "恢复默认系统参数" as UCRestoreSetting
    usecase "查看登录日志" as UCLoginLog
    usecase "查看操作日志" as UCOperationLog
    usecase "查看错误日志" as UCErrorLog
    usecase "标记错误已处理" as UCResolveError
    usecase "查看备份摘要 / 列表" as UCBackupList
    usecase "创建备份" as UCCreateBackup
    usecase "恢复备份" as UCRestoreBackup
    usecase "校验备份" as UCVerifyBackup
    usecase "下载备份" as UCDownloadBackup
    usecase "删除备份" as UCDeleteBackup
  }
}

Admin --> UCDashboard
Admin --> UCHealth
Admin --> UCTestAll
Admin --> UCMonitoring
Admin --> UCTimeseries
Admin --> UCUserStats
Admin --> UCUserList
Admin --> UCUserDetail
Admin --> UCCreateUser
Admin --> UCUpdateUser
Admin --> UCResetUserPassword
Admin --> UCDeleteUser
Admin --> UCCourseStats
Admin --> UCCourseList
Admin --> UCCourseDetail
Admin --> UCTakeoverCourse
Admin --> UCActivateCourse
Admin --> UCMaterialStats
Admin --> UCMaterialList
Admin --> UCDeleteMaterial
Admin --> UCModelList
Admin --> UCSaveModel
Admin --> UCTestModel
Admin --> UCDeleteModel
Admin --> UCModelUsage
Admin --> UCServiceList
Admin --> UCSaveService
Admin --> UCTestService
Admin --> UCDeleteService
Admin --> UCSettingList
Admin --> UCUpdateSetting
Admin --> UCRestoreSetting
Admin --> UCLoginLog
Admin --> UCOperationLog
Admin --> UCErrorLog
Admin --> UCResolveError
Admin --> UCBackupList
Admin --> UCCreateBackup
Admin --> UCRestoreBackup
Admin --> UCVerifyBackup
Admin --> UCDownloadBackup
Admin --> UCDeleteBackup

LLM --> UCTestModel
VectorService --> UCTestModel
DocParser --> UCTestService
OCR --> UCTestService
TTS --> UCTestService
OSS --> UCTestService
Mail --> UCTestService
Runtime --> UCHealth
Runtime --> UCMonitoring
Runtime --> UCCreateBackup
Runtime --> UCRestoreBackup

UCDashboard ..> UCHealth : <<include>>
UCDashboard ..> UCMonitoring : <<include>>
UCDashboard ..> UCUserStats : <<include>>
UCDashboard ..> UCCourseStats : <<include>>
UCTestAll ..> UCTestModel : <<include>>
UCTestAll ..> UCTestService : <<include>>
UCUserDetail ..> UCUserList : <<extend>>
UCResetUserPassword ..> UCUpdateUser : <<extend>>
UCTakeoverCourse ..> UCCourseDetail : <<extend>>
UCActivateCourse ..> UCCourseDetail : <<extend>>
UCDeleteMaterial ..> UCMaterialList : <<extend>>
UCTestModel ..> UCSaveModel : <<extend>>
UCTestService ..> UCSaveService : <<extend>>
UCRestoreSetting ..> UCSettingList : <<extend>>
UCResolveError ..> UCErrorLog : <<extend>>
UCCreateBackup ..> UCBackupList : <<extend>>
UCRestoreBackup ..> UCBackupList : <<extend>>
UCVerifyBackup ..> UCBackupList : <<extend>>
UCDownloadBackup ..> UCBackupList : <<extend>>
UCDeleteBackup ..> UCBackupList : <<extend>>

@enduml
