@startuml
title 内容、课时、问答与学习信号概念类图
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Noto Sans CJK SC
skinparam titleFontName Noto Sans CJK SC
skinparam classFontName Noto Sans CJK SC
skinparam classAttributeFontName Noto Sans CJK SC
hide methods

abstract class "用户" as User {
  id
  role
  nickname
}

class "学生" as Student
class "教师" as Teacher
class "课程" as Course {
  name
  courseCode
  term
  status
}

class "课程成员" as CourseMembership {
  role
  joinedAt
}

class "章节" as Chapter {
  title
  orderIndex
}

class "课程资料" as CourseMaterial {
  title
  category
  materialType
  parseStatus
  vectorStatus
}

class "课时" as Lesson {
  title
  pageCount
  status
  publishedAt
}

class "课时页" as LessonPage {
  pageNumber
  pageText
  scriptText
  audioUrl
  subtitleText
}

class "教学产物" as PedagogyArtifact {
  artifactType
  title
  content
}

class "知识块" as KnowledgeChunk {
  title
  content
  embedding
  sourceMeta
}

class "知识点" as KnowledgePoint {
  name
  description
  contentByLevel
}

class "学习进度" as LearningProgress {
  currentPage
  progressPercent
  totalStudySeconds
}

class "页笔记" as PageNote {
  content
}

class "问答会话" as QAConversation {
  title
}

class "问答记录" as QARecord {
  question
  answer
  sources
  feedback
}

class "学习信号" as StudentLearningSignal {
  sourceType
  intent
  score
  confidence
}

User <|-- Student
User <|-- Teacher
Teacher "1" -- "0..*" Course : 授课
Course "1" o-- "0..*" CourseMembership : 成员关系
User "1" -- "0..*" CourseMembership : 加入课程

Course "1" *-- "0..*" Chapter : 章节
Course "1" *-- "0..*" CourseMaterial : 资料库
Chapter "0..1" -- "0..*" CourseMaterial : 章节归属
CourseMaterial "1" *-- "0..1" Lesson : 处理生成
Lesson "1" *-- "1..*" LessonPage : 页面
LessonPage "1" *-- "0..*" PedagogyArtifact : 活动 / 讲稿产物
Course "1" *-- "0..*" KnowledgeChunk : 知识块
CourseMaterial "0..1" -- "0..*" KnowledgeChunk : 来源资料
LessonPage "0..1" -- "0..*" KnowledgeChunk : 来源页面
Course "1" *-- "0..*" KnowledgePoint : 知识点
Chapter "0..1" -- "0..*" KnowledgePoint : 章节知识点

Student "1" -- "0..*" LearningProgress : 学习进度
LearningProgress "*" -- "1" Lesson : 对应课时
Student "1" -- "0..*" PageNote : 保存笔记
PageNote "*" -- "1" LessonPage : 页面笔记

Student "1" -- "0..*" QAConversation : 发起
Course "1" -- "0..*" QAConversation : 课程问答范围
QAConversation "1" *-- "1..*" QARecord : 问答记录
QARecord "*" --> "0..*" KnowledgeChunk : 引用来源
QARecord "*" --> "0..1" LessonPage : 当前页上下文
QARecord "*" --> "0..*" StudentLearningSignal : 形成信号
StudentLearningSignal "*" --> "1" KnowledgePoint : 指向知识点
StudentLearningSignal "*" -- "1" Course : 所属课程

@enduml
