@startuml
title 智学黑板 ClassAgent 完整用例总览图
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Noto Sans CJK SC
skinparam titleFontName Noto Sans CJK SC
skinparam actorFontName Noto Sans CJK SC
skinparam usecaseFontName Noto Sans CJK SC
skinparam packageFontName Noto Sans CJK SC

actor "访客" as Guest
actor "平台用户" as PlatformUser
actor "学生" as Student
actor "教师" as Teacher
actor "管理员" as Admin
actor "外部大模型服务" as LLM
actor "Embedding / 向量库" as VectorService
actor "文档解析服务" as DocParser
actor "OCR 服务" as OCR
actor "TTS 服务" as TTS
actor "对象存储服务" as OSS
actor "邮件 / 通知服务" as Mail

Student --|> PlatformUser
Teacher --|> PlatformUser
Admin --|> PlatformUser

rectangle "ClassAgent 智学黑板平台" {
  package "认证与个人中心" {
    usecase "学生注册" as UCRegister
    usecase "登录" as UCLogin
    usecase "找回密码" as UCResetPassword
    usecase "发送验证码 / 通知" as UCSendMail
    usecase "获取当前用户" as UCMe
    usecase "修改个人资料" as UCUpdateProfile
    usecase "修改登录密码" as UCChangePassword
    usecase "上传头像" as UCUploadAvatar
    usecase "维护通知偏好" as UCNotificationPreference
    usecase "读取 / 标记通知" as UCReadNotification
  }

  package "课程与成员" {
    usecase "创建课程" as UCCreateCourse
    usecase "查看授课 / 已加入课程" as UCListCourses
    usecase "查看课程详情 / 主页" as UCViewCourse
    usecase "预览课程码" as UCPreviewCourseCode
    usecase "加入课程" as UCJoinCourse
    usecase "退出课程" as UCLeaveCourse
    usecase "修改课程信息 / 封面" as UCUpdateCourse
    usecase "停用 / 激活课程" as UCActivateCourse
    usecase "查看课程成员" as UCViewMembers
    usecase "创建章节" as UCCreateChapter
    usecase "更新 / 删除章节" as UCUpdateChapter
  }

  package "资料、课时与知识库" {
    usecase "上传课程资料" as UCUploadMaterial
    usecase "检索 / 查看资料" as UCViewMaterial
    usecase "预览资料原文" as UCPreviewMaterial
    usecase "修改 / 删除资料" as UCUpdateMaterial
    usecase "重新处理资料" as UCReprocessMaterial
    usecase "解析文档内容" as UCDocParse
    usecase "生成课时页" as UCLessonBuild
    usecase "生成 / 修改讲稿" as UCScriptBuild
    usecase "生成音频与字幕" as UCTTSBuild
    usecase "构建知识块与向量索引" as UCVectorBuild
    usecase "查看课时列表 / 详情" as UCViewLesson
    usecase "发布 / 下线课时" as UCPublishLesson
    usecase "复制 / 修改 / 删除课时" as UCManageLesson
    usecase "生成活动层 / 教学产物" as UCPedagogy
  }

  package "学生学习" {
    usecase "查看学生学习台" as UCStudentDashboard
    usecase "学习课时" as UCStudyLesson
    usecase "上报学习进度" as UCReportProgress
    usecase "保存课时笔记" as UCSaveNote
    usecase "查看学习记录" as UCLearningRecords
    usecase "查看知识点讲解" as UCViewKnowledgePoint
    usecase "创建学习计划" as UCCreateStudyPlan
    usecase "查看计划任务" as UCViewStudyTasks
    usecase "学习任务打卡" as UCCheckin
  }

  package "AI 问答与题目辅导" {
    usecase "上传问答图片附件" as UCUploadQAImage
    usecase "识别图片文字" as UCOCRRecognize
    usecase "课程 / 课件页问答" as UCAsk
    usecase "流式问答" as UCAskStream
    usecase "检索课程知识上下文" as UCRetrieve
    usecase "调用问答模型生成回答" as UCGenerateAnswer
    usecase "查看问答历史 / 会话" as UCQAHistory
    usecase "收藏问答" as UCFavoriteQA
    usecase "评价问答" as UCFeedbackQA
    usecase "文本题目辅导" as UCTextTutoring
    usecase "图片题目辅导" as UCImageTutoring
    usecase "确认 / 修正 OCR 题干" as UCConfirmProblem
    usecase "获取分级辅导" as UCProblemGuidance
    usecase "查看辅导历史" as UCTutoringHistory
  }

  package "测验、错题与薄弱点" {
    usecase "生成测验 / 练习" as UCGenerateQuiz
    usecase "编辑测验内容" as UCEditQuiz
    usecase "发布测验" as UCPublishQuiz
    usecase "查看测验列表 / 详情" as UCViewQuiz
    usecase "提交测验" as UCSubmitQuiz
    usecase "查看测验结果 / 尝试" as UCViewAttempt
    usecase "维护错题本" as UCWrongBook
    usecase "生成错题练习" as UCWrongPractice
    usecase "查看薄弱点" as UCWeakPoint
    usecase "教师生成薄弱点测验" as UCTeacherWeakQuiz
    usecase "查看薄弱点测验作答" as UCWeakQuizAttempt
    usecase "轮询生成任务" as UCGenerationTask
  }

  package "教师工作台与教学分析" {
    usecase "查看教师工作台" as UCTeacherDashboard
    usecase "查看教师课程列表 / 课程主页" as UCTeacherCourses
    usecase "查看资料统计摘要" as UCMaterialSummary
    usecase "查看学生列表 / 详情" as UCStudentManage
    usecase "导出学生名单" as UCExportStudents
    usecase "提醒学生" as UCRemindStudent
    usecase "移除学生" as UCRemoveStudent
    usecase "查看课程教学分析" as UCAnalysis
    usecase "导出教学分析" as UCExportAnalysis
  }

  package "管理员后台与运维" {
    usecase "查看管理仪表盘" as UCAdminDashboard
    usecase "用户统计 / 列表 / 详情" as UCAdminUserQuery
    usecase "创建 / 修改 / 删除用户" as UCAdminUserManage
    usecase "重置用户密码" as UCAdminResetUserPassword
    usecase "课程统计 / 列表 / 详情" as UCAdminCourseQuery
    usecase "接管 / 启停课程" as UCAdminCourseManage
    usecase "资料统计 / 审核 / 删除" as UCAdminMaterialManage
    usecase "配置模型" as UCModelConfig
    usecase "查看模型用量" as UCModelUsage
    usecase "配置外部服务" as UCServiceConfig
    usecase "检测服务健康" as UCServiceHealth
    usecase "维护系统参数" as UCSystemSetting
    usecase "查看系统监控" as UCMonitoring
    usecase "查看登录 / 操作 / 错误日志" as UCLogs
    usecase "标记错误已处理" as UCResolveError
    usecase "备份 / 恢复 / 校验 / 下载 / 删除" as UCBackup
  }
}

Guest --> UCRegister
Guest --> UCLogin
