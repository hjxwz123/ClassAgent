Teacher --> UCRemindStudent
Teacher --> UCRemoveStudent
Teacher --> UCAnalysis
Teacher --> UCExportAnalysis

Admin --> UCCreateCourse
Admin --> UCUpdateCourse
Admin --> UCActivateCourse
Admin --> UCUploadMaterial
Admin --> UCViewMaterial
Admin --> UCUpdateMaterial
Admin --> UCPublishLesson
Admin --> UCGenerateQuiz
Admin --> UCPublishQuiz
