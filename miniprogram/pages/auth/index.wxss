.auth {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 120rpx) 48rpx 60rpx;
  background: linear-gradient(180deg, #121614 0%, #1c2320 42%, #F9F8F6 42%, #F9F8F6 100%);
}

.auth__brand {
  text-align: center;
  margin-bottom: 56rpx;
}
.auth__logo {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #00e5ff 0%, #00b8d4 100%);
  color: #fff;
  font-size: 60rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 184, 212, 0.35);
}
.auth__title { font-size: 44rpx; font-weight: 700; color: #F4F4F0; }
.auth__slogan { font-size: 26rpx; color: #8C948F; margin-top: 8rpx; }

.auth__card {
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(18, 22, 20, 0.12);
}

.seg {
  display: flex;
  background: #F2F1EC;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 32rpx;
}
.seg__item {
  flex: 1;
  text-align: center;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  color: #666560;
  border-radius: 9rpx;
}
.seg__item--on {
  background: #fff;
  color: #00B8D4;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.role-pick { display: flex; gap: 16rpx; }
.role-pick__item {
  flex: 1;
  text-align: center;
  height: 80rpx;
  line-height: 80rpx;
  border: 1rpx solid #E6E4DD;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #444440;
}
.role-pick__item--on {
  border-color: #00B8D4;
  background: #E0F7FA;
  color: #0097A7;
  font-weight: 600;
}

.hint-box {
  background: #E1F5FE;
  color: #0277BD;
  font-size: 26rpx;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}
