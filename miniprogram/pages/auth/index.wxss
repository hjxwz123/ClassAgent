.auth {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 120rpx) 48rpx 60rpx;
  background: linear-gradient(180deg, #121614 0%, #1c2320 42%, #F9F8F6 42%, #F9F8F6 100%);
}

.auth__brand {
  text-align: center;
  margin-bottom: 56rpx;
}
.auth__logo {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #00e5ff 0%, #00b8d4 100%);
  color: #fff;
  font-size: 60rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 184, 212, 0.35);
}
.auth__title { font-size: 44rpx; font-weight: 700; color: #F4F4F0; }
.auth__slogan { font-size: 26rpx; color: #8C948F; margin-top: 8rpx; }

.auth__card {
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(18, 22, 20, 0.12);
}

/* 登录卡片底部引导文案 */
.auth__note {
  text-align: center;
  margin-top: 24rpx;
}
