<view class="page page--tab">
  <view class="row-between">
    <view class="course-sel course-sel--teacher" hover-class="hover-dim" bindtap="toggleCoursePicker">
      <text class="ellipsis">{{courseName}}</text>
      <icon class="course-sel__arrow" name="chevron-down" size="24rpx" color="#D94925" />
    </view>
  </view>

  <view class="chips mt-16">
    <view wx:for="{{ranges}}" wx:key="key" class="chip chip--teacher {{range === item.key ? 'chip--on' : ''}}" hover-class="hover-dim" data-key="{{item.key}}" bindtap="setRange">{{item.label}}</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="card"><view class="skeleton skeleton-line"></view></view>
  </block>

  <!-- 加载失败占位 -->
  <view wx:elif="{{error}}" class="empty">
    <view class="empty__text">加载失败：{{error}}</view>
    <button class="btn btn--outline btn--sm" bindtap="retryLoad">重新加载</button>
  </view>

  <!-- 无课程空态 -->
  <view wx:elif="{{!courses.length}}" class="empty">
    <icon class="empty__icon" name="book" size="64rpx" color="#D94925" />
    <view class="empty__text">暂无课程，创建课程后可查看教学分析</view>
  </view>

  <block wx:elif="{{analysis}}">
    <!-- AI 建议 -->
    <view wx:if="{{analysis.suggestion}}" class="card ai-suggest fade-in">
      <view class="row gap-8"><icon class="ai-suggest__spark" name="spark" size="36rpx" color="#D94925" /><text class="tag tag--ai">AI 教学建议</text></view>
      <view class="text-body mt-16">{{analysis.suggestion}}</view>
    </view>

    <!-- 指标 -->
    <view class="metric-grid">
      <view wx:for="{{metrics}}" wx:key="label" class="metric">
        <view class="metric__num num">{{item.value}}<text class="metric__unit">{{item.unit}}</text></view>
        <view class="metric__label">{{item.label}}</view>
      </view>
    </view>

    <!-- 课时完成率 -->
    <view class="section-title">课时完成率</view>
    <view class="card" wx:if="{{lessonBars.length}}">
      <view wx:for="{{lessonBars}}" wx:key="title" class="bar-row">
        <text class="bar-row__label ellipsis">{{item.title}}</text>
        <view class="bar-row__track"><view class="bar-row__fill" style="width:{{item.width}}%"></view></view>
        <text class="bar-row__val num">{{item.value}}%</text>
      </view>
    </view>
    <view wx:else class="card text-sub">暂无课时数据</view>

    <!-- 活跃分层 -->
    <view class="section-title">活跃分层</view>
    <view class="card layer-row">
      <view wx:for="{{layers}}" wx:key="label" class="layer layer--{{item.cls}}">
        <view class="layer__num num">{{item.value}}</view>
        <view class="layer__label">{{item.label}}</view>
      </view>
    </view>

    <!-- 高频问题 -->
    <block wx:if="{{analysis.high_frequency_questions.length}}">
      <view class="section-title">高频问题</view>
      <view class="card">
        <view wx:for="{{analysis.high_frequency_questions}}" wx:key="index" wx:if="{{index < 8}}" class="freq-row">
          <text class="freq-row__rank num">{{index + 1}}</text>
          <text class="flex-1 ellipsis">{{item.question}}</text>
          <text class="text-muted" style="font-size:24rpx">{{item.count}} 次</text>
        </view>
      </view>
    </block>

    <view class="text-muted mt-16" style="font-size:24rpx;text-align:center">导出完整报告请前往桌面端</view>
  </block>
</view>

<!-- 课程选择 -->
<view wx:if="{{coursePickerOpen}}" class="sheet-mask" bindtap="toggleCoursePicker"></view>
<view wx:if="{{coursePickerOpen}}" class="sheet sheet--tab" catchtap="">
  <view class="sheet__handle"></view>
  <view class="sheet__title">选择课程</view>
  <scroll-view scroll-y style="max-height:50vh">
    <view wx:for="{{courses}}" wx:key="id" class="pick-row" hover-class="hover-bg" data-id="{{item.id}}" bindtap="pickCourse">
      <text class="flex-1 ellipsis">{{item.name}}</text>
      <icon wx:if="{{item.id === courseId}}" name="check" size="30rpx" color="#D94925" />
    </view>
  </scroll-view>
</view>
