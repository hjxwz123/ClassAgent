<view class="page page--tab">
  <view class="hero banner banner--teacher fade-in">
    <view class="hero__greeting">{{greeting}}，{{nickname}}</view>
    <view class="hero__sub">移动端可处理高频教学任务，复杂编辑请前往桌面端</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="card"><view class="skeleton skeleton-line"></view></view>
  </block>

  <block wx:elif="{{dashboard}}">
    <!-- 统计 2x2 -->
    <view class="t-stats">
      <view wx:for="{{statCards}}" wx:key="label" class="t-stat">
        <view class="t-stat__num num {{item.warn ? 'text-teacher' : ''}}">{{item.value}}</view>
        <view class="t-stat__label">{{item.label}}</view>
      </view>
    </view>

    <!-- 近期课程 -->
    <block wx:if="{{dashboard.recent_courses.length}}">
      <view class="section-title">近期课程</view>
      <view class="card">
        <view wx:for="{{dashboard.recent_courses}}" wx:key="id" wx:if="{{index < 4}}" class="t-course-row" data-id="{{item.id}}" bindtap="openCourse">
          <view class="flex-1">
            <view class="ellipsis" style="font-weight:600">{{item.name}}</view>
            <view class="text-muted" style="font-size:24rpx">{{item.term}} · {{item.student_count}} 名学生</view>
          </view>
          <text class="text-muted">›</text>
        </view>
      </view>
    </block>

    <!-- 待办事项 -->
    <view class="section-title">待办事项</view>
    <view class="card" wx:if="{{dashboard.todos.length}}">
      <view wx:for="{{dashboard.todos}}" wx:key="index" class="todo-row">
        <text class="todo-row__dot todo-row__dot--{{item.type}}"></text>
        <text class="flex-1 ellipsis">{{item.title}}</text>
        <text class="text-muted" style="font-size:24rpx">{{item.type === 'error' ? '失败' : '待处理'}}</text>
      </view>
    </view>
    <view wx:else class="card text-sub">暂无待办事项，教学进展顺利</view>

    <!-- 待审核脚本 -->
    <block wx:if="{{dashboard.pending_scripts.length}}">
      <view class="section-title">待审核脚本</view>
      <view class="card">
        <view wx:for="{{dashboard.pending_scripts}}" wx:key="page_id" wx:if="{{index < 4}}" class="todo-row">
          <text class="flex-1 ellipsis">{{item.lesson_title}} · 第 {{item.page_number}} 页</text>
          <text class="tag tag--warning">待审核</text>
        </view>
        <view class="text-muted mt-16" style="font-size:24rpx">脚本编辑请前往桌面端处理</view>
      </view>
    </block>

    <!-- AI 任务 -->
    <block wx:if="{{dashboard.ai_tasks.length}}">
      <view class="section-title">AI 任务状态</view>
      <view class="card">
        <view wx:for="{{dashboard.ai_tasks}}" wx:key="index" class="todo-row">
          <text class="flex-1 ellipsis">{{item.task_name || item.title || 'AI 任务'}}</text>
          <text class="tag {{item.status === 'ready' || item.status === 'completed' ? 'tag--success' : 'tag--info'}}">{{item.status}}</text>
        </view>
      </view>
    </block>
  </block>
</view>
