<view class="page page--tab">
  <view class="h1">我的课程</view>

  <view class="search mt-16">
    <text class="search__icon">🔍</text>
    <input class="search__input" placeholder="搜索课程名称" value="{{keyword}}" bindinput="onSearch" />
  </view>

  <view class="chips mt-16">
    <view class="chip chip--teacher {{status === 'all' ? 'chip--on' : ''}}" data-status="all" bindtap="setStatus">全部</view>
    <view class="chip chip--teacher {{status === 'active' ? 'chip--on' : ''}}" data-status="active" bindtap="setStatus">已上架</view>
    <view class="chip chip--teacher {{status === 'inactive' ? 'chip--on' : ''}}" data-status="inactive" bindtap="setStatus">已下架</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="card"><view class="skeleton skeleton-line"></view></view>
  </block>

  <block wx:elif="{{filtered.length}}">
    <view wx:for="{{filtered}}" wx:key="id" class="card t-course-card fade-in" data-id="{{item.id}}" bindtap="openCourse">
      <view class="row-between">
        <view class="flex-1">
          <view class="ellipsis" style="font-weight:600;font-size:32rpx">{{item.name}}</view>
          <view class="text-sub mt-8">{{item.term}}</view>
        </view>
        <text class="tag {{item.status === 'active' ? 'tag--success' : 'tag--warning'}}">{{item.status === 'active' ? '已上架' : '已下架'}}</text>
      </view>

      <view class="t-course-meta mt-16">
        <view class="t-course-meta__cell"><text class="num">{{item.student_count}}</text><text>学生</text></view>
        <view class="t-course-meta__cell"><text class="num">{{item.lesson_count}}</text><text>课时</text></view>
        <view class="t-course-meta__cell"><text class="num">{{item.material_count}}</text><text>资料</text></view>
        <view class="t-course-meta__cell"><text class="num">{{item.rate}}%</text><text>发布率</text></view>
      </view>

      <view class="row-between mt-16">
        <view class="tag tag--code" catchtap="copyCode" data-code="{{item.course_code}}">{{item.course_code}} 复制</view>
        <button class="btn btn--outline btn--sm" catchtap="toggleStatus" data-id="{{item.id}}" data-status="{{item.status}}">{{item.status === 'active' ? '下架' : '上架'}}</button>
      </view>
    </view>
  </block>

  <view wx:else class="empty">
    <view class="empty__icon">📗</view>
    <view class="empty__text">暂无课程，复杂课程创建请前往桌面端</view>
  </view>
</view>
