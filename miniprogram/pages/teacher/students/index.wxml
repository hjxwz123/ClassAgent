<view class="page page--tab">
  <view class="course-sel course-sel--teacher" hover-class="hover-dim" bindtap="toggleCoursePicker">
    <text class="ellipsis">{{courseName}}</text>
    <icon class="course-sel__arrow" name="chevron-down" size="24rpx" color="#D94925" />
  </view>

  <!-- 统计 -->
  <view class="banner banner--teacher mt-16 fade-in stat-banner">
    <view class="stat-banner__cell"><view class="stat-banner__num num">{{stats.total || 0}}</view><view class="stat-banner__lbl">学生总数</view></view>
    <view class="stat-banner__cell"><view class="stat-banner__num num">{{stats.active_7d || 0}}</view><view class="stat-banner__lbl">活跃学生</view></view>
    <view class="stat-banner__cell"><view class="stat-banner__num num">{{stats.average_completion || 0}}%</view><view class="stat-banner__lbl">平均完成</view></view>
    <view class="stat-banner__cell"><view class="stat-banner__num num">{{stats.inactive_14d || 0}}</view><view class="stat-banner__lbl">长期未活</view></view>
  </view>

  <view class="search mt-16">
    <icon class="search__icon" name="search" size="28rpx" color="#999990" />
    <input class="search__input" placeholder="搜索学生姓名" confirm-type="search" value="{{keyword}}" bindinput="onSearch" />
  </view>
  <view class="chips mt-16">
    <view class="chip chip--teacher {{filter === 'all' ? 'chip--on' : ''}}" hover-class="hover-dim" data-filter="all" bindtap="setFilter">全部</view>
    <view class="chip chip--teacher {{filter === 'active' ? 'chip--on' : ''}}" hover-class="hover-dim" data-filter="active" bindtap="setFilter">活跃</view>
    <view class="chip chip--teacher {{filter === 'inactive' ? 'chip--on' : ''}}" hover-class="hover-dim" data-filter="inactive" bindtap="setFilter">未活跃</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="card"><view class="skeleton skeleton-line"></view></view>
  </block>

  <!-- 加载失败占位 -->
  <view wx:elif="{{error}}" class="empty">
    <view class="empty__text">加载失败：{{error}}</view>
    <button class="btn btn--outline btn--sm" bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:elif="{{filtered.length}}">
    <view wx:for="{{filtered}}" wx:key="membership_id" class="card stu-card fade-in" hover-class="hover-card" data-id="{{item.student.id}}" bindtap="openDetail">
      <view class="row gap-16">
        <view class="stu-avatar">
          <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" lazy-load class="stu-avatar__img" />
          <text wx:else>{{item.name[0]}}</text>
        </view>
        <view class="flex-1">
          <view style="font-weight:600">{{item.name}}</view>
          <view class="text-muted" style="font-size:24rpx">{{item.no || '无学号'}} · {{item.lastText}}</view>
        </view>
      </view>
      <view class="progress mt-16"><view class="progress__bar progress__bar--teacher" style="width:{{item.progress_percent}}%"></view></view>
      <view class="row-between mt-16">
        <view class="row gap-24">
          <text class="text-sub">课时 {{item.studied_lessons}}/{{item.lesson_total}}</text>
          <text class="text-sub">问答 {{item.qa_count}}</text>
          <text class="text-sub">错题 {{item.wrong_count}}</text>
        </view>
        <button class="btn btn--outline btn--sm" catchtap="openRemind" data-id="{{item.student.id}}">提醒</button>
      </view>
    </view>
  </block>

  <!-- 有学生但筛选无结果 -->
  <view wx:elif="{{filtering}}" class="empty">
    <icon class="empty__icon" name="search" size="64rpx" color="#D94925" />
    <view class="empty__text">未找到匹配学生</view>
    <button class="btn btn--outline btn--sm" bindtap="clearFilter">清除筛选</button>
  </view>

  <!-- 无课程 -->
  <view wx:elif="{{!courses.length}}" class="empty">
    <icon class="empty__icon" name="book" size="64rpx" color="#D94925" />
    <view class="empty__text">暂无课程，创建课程后可管理学生</view>
  </view>

  <!-- 课程内暂无学生：引导分享课程码 -->
  <view wx:else class="empty">
    <icon class="empty__icon" name="users" size="64rpx" color="#D94925" />
    <view class="empty__text">暂无学生，分享课程码邀请学生加入</view>
    <button class="btn btn--outline btn--sm" bindtap="copyCourseCode">复制课程码</button>
  </view>
</view>

<!-- 课程选择 -->
<view wx:if="{{coursePickerOpen}}" class="sheet-mask" bindtap="toggleCoursePicker"></view>
<view wx:if="{{coursePickerOpen}}" class="sheet sheet--tab" catchtap="">
  <view class="sheet__handle"></view>
  <view class="sheet__title">选择课程</view>
  <scroll-view scroll-y style="max-height:50vh">
    <view wx:for="{{courses}}" wx:key="id" class="pick-row" hover-class="hover-bg" data-id="{{item.id}}" bindtap="pickCourse">
      <text class="flex-1 ellipsis">{{item.name}}</text>
      <icon wx:if="{{item.id === courseId}}" name="check" size="30rpx" color="#D94925" />
    </view>
  </scroll-view>
</view>

<!-- 提醒 -->
<view wx:if="{{remindOpen}}" class="sheet-mask" bindtap="closeRemind"></view>
<view wx:if="{{remindOpen}}" class="sheet sheet--tab" catchtap="">
  <view class="sheet__handle"></view>
  <view class="sheet__title">提醒 {{remindStudent.name}}</view>
  <view class="field">
    <view class="field__label">标题</view>
    <input class="input" value="{{remindForm.title}}" bindinput="onRemindTitle" />
  </view>
  <view class="field">
    <view class="field__label">提醒内容</view>
    <textarea class="textarea" value="{{remindForm.message}}" bindinput="onRemindMsg" />
  </view>
  <button class="btn btn--teacher btn--block mt-8" loading="{{sending}}" disabled="{{sending}}" bindtap="sendRemind">发送提醒</button>
</view>
