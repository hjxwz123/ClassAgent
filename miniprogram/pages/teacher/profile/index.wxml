<view class="page page--tab">
  <block wx:if="{{loading}}">
    <view class="card"><view class="skeleton skeleton-line"></view></view>
  </block>

  <block wx:elif="{{profile}}">
    <view class="id-card banner banner--teacher fade-in">
      <view class="row gap-24">
        <view class="id-card__avatar" hover-class="hover-dim" bindtap="changeAvatar">
          <image wx:if="{{form.avatar_url}}" src="{{form.avatar_url}}" mode="aspectFill" class="id-card__avatar-img" />
          <text wx:else>{{form.nickname[0] || '师'}}</text>
        </view>
        <view class="flex-1">
          <view class="id-card__name">{{form.nickname || '老师'}}</view>
          <view class="id-card__meta">教师{{profile.user.employee_no ? ' · 工号 ' + profile.user.employee_no : ''}}</view>
          <view class="id-card__meta">{{profile.user.email}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title" style="margin-top:0">个人资料</view>
      <view class="field">
        <view class="field__label">昵称</view>
        <input class="input" value="{{form.nickname}}" data-field="nickname" bindinput="onForm" />
      </view>
      <view class="field">
        <view class="field__label">所属机构</view>
        <input class="input" value="{{form.organization}}" placeholder="选填" data-field="organization" bindinput="onForm" />
      </view>
      <view class="field">
        <view class="field__label">院系/部门</view>
        <input class="input" value="{{form.department}}" placeholder="选填" data-field="department" bindinput="onForm" />
      </view>
      <view class="field">
        <view class="field__label">简介</view>
        <textarea class="textarea" value="{{form.bio}}" data-field="bio" bindinput="onForm" />
      </view>
      <button class="btn btn--teacher btn--block" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存资料</button>
    </view>

    <view class="card">
      <view class="section-title" style="margin-top:0">通知设置</view>
      <view wx:for="{{notices}}" wx:key="key" class="notice-row">
        <text class="flex-1">{{item.label}}</text>
        <switch checked="{{item.enabled}}" color="#D94925" data-index="{{index}}" bindchange="toggleNotice" />
      </view>
    </view>

    <view class="card">
      <view class="list-link" hover-class="hover-bg" bindtap="openPwd"><text class="flex-1">修改密码</text><text class="text-muted">›</text></view>
    </view>

    <button class="btn btn--danger btn--block" bindtap="logout">退出登录</button>
  </block>
</view>

<!-- 改密 -->
<view wx:if="{{pwdOpen}}" class="sheet-mask" bindtap="closePwd"></view>
<view wx:if="{{pwdOpen}}" class="sheet" catchtap="">
  <view class="sheet__handle"></view>
  <view class="sheet__title">修改密码</view>
  <view class="field"><view class="field__label">当前密码</view><input class="input" password value="{{pwd.old_password}}" data-field="old_password" bindinput="onPwd" /></view>
  <view class="field"><view class="field__label">新密码</view><input class="input" password placeholder="至少 8 位" value="{{pwd.new_password}}" data-field="new_password" bindinput="onPwd" /></view>
  <view class="field"><view class="field__label">确认新密码</view><input class="input" password value="{{pwd.confirm}}" data-field="confirm" bindinput="onPwd" /></view>
  <button class="btn btn--teacher btn--block mt-8" bindtap="submitPwd">保存</button>
</view>
