<view class="page page--tab">
  <view class="row-between">
    <view class="course-sel" hover-class="hover-dim" bindtap="toggleCoursePicker">
      <text class="ellipsis">{{courseName}}</text>
      <icon class="course-sel__arrow" name="chevron-down" size="24rpx" color="#0097A7" />
    </view>
    <button class="btn btn--primary btn--sm" loading="{{generating}}" bindtap="startPractice">开始重练</button>
  </view>

  <!-- 统计横幅 -->
  <view class="stat-banner banner banner--student mt-16 fade-in">
    <view class="stat-banner__cell"><view class="stat-banner__num num">{{stats.total}}</view><view class="stat-banner__lbl">历史错题</view></view>
    <view class="stat-banner__cell"><view class="stat-banner__num num">{{stats.pending}}</view><view class="stat-banner__lbl">待重练</view></view>
    <view class="stat-banner__cell"><view class="stat-banner__num num">{{stats.repeat}}</view><view class="stat-banner__lbl">多次错误</view></view>
    <view class="stat-banner__cell"><view class="stat-banner__num num">{{stats.week}}</view><view class="stat-banner__lbl">本周新增</view></view>
  </view>

  <view class="search mt-16">
    <icon class="search__icon" name="search" size="28rpx" color="#999990" />
    <input class="search__input" placeholder="搜索题干关键词" confirm-type="search" value="{{keyword}}" bindinput="onSearch" />
  </view>

  <view class="chips mt-16">
    <view class="chip {{status === 'all' ? 'chip--on' : ''}}" hover-class="hover-bg" data-status="all" bindtap="setStatus">全部</view>
    <view class="chip {{status === 'pending' ? 'chip--on' : ''}}" hover-class="hover-bg" data-status="pending" bindtap="setStatus">待重练</view>
    <view class="chip {{status === 'resolved' ? 'chip--on' : ''}}" hover-class="hover-bg" data-status="resolved" bindtap="setStatus">已掌握</view>
  </view>

  <view wx:if="{{weakPoints.length}}" class="weak-strip mt-16">
    <text wx:for="{{weakPoints}}" wx:key="knowledge_point" wx:if="{{index < 6}}" class="tag tag--warning weak-strip__tag">{{item.knowledge_point}} · {{item.wrong_count}}</text>
  </view>

  <block wx:if="{{loading}}">
    <view class="card"><view class="skeleton skeleton-line"></view><view class="skeleton skeleton-line" style="width:70%"></view></view>
  </block>

  <block wx:elif="{{filtered.length}}">
    <view wx:for="{{filtered}}" wx:key="wrong_question_id" class="card wrong-card fade-in" hover-class="hover-card" data-index="{{index}}" bindtap="toggleExpand">
      <view class="row-between">
        <view class="row gap-8">
          <text class="tag {{item.is_resolved ? 'tag--success' : 'tag--error'}}">{{item.is_resolved ? '已掌握' : '待重练'}}</text>
          <text class="tag tag--warning" wx:if="{{item.wrong_count > 1}}">错 {{item.wrong_count}} 次</text>
        </view>
        <text class="text-muted" style="font-size:24rpx">{{item.knowledge_point_name || '未标注'}}</text>
      </view>
      <view class="wrong-card__stem {{item.expanded ? '' : 'clamp-4'}}">{{item.question.stem}}</view>
      <view wx:if="{{item.expanded && item.question.explanation}}" class="wrong-card__exp">
        <view class="wrong-card__exp-title">解析</view>
        <view>{{item.question.explanation}}</view>
      </view>
      <view class="row-between mt-16">
        <text class="text-muted" style="font-size:24rpx">{{item.expanded ? '收起' : '展开'}}</text>
      </view>
    </view>
  </block>

  <view wx:else class="empty">
    <icon class="empty__icon" name="{{courses.length ? 'check-circle' : 'book'}}" size="64rpx" color="{{courses.length ? '#2E7D32' : '#00B8D4'}}" />
    <view class="empty__text">{{!courses.length ? '加入课程后才有错题记录' : (keyword || status !== 'all' ? '没有匹配的错题' : '本课程暂无错题')}}</view>
    <button wx:if="{{!courses.length}}" class="btn btn--primary btn--sm" bindtap="goCourses">先加入课程</button>
    <button wx:elif="{{!keyword && status === 'all'}}" class="btn btn--primary btn--sm" bindtap="toggleCoursePicker">切换课程</button>
  </view>
</view>

<!-- 课程选择 -->
<view wx:if="{{coursePickerOpen}}" class="sheet-mask" bindtap="toggleCoursePicker"></view>
<view wx:if="{{coursePickerOpen}}" class="sheet" catchtap="">
  <view class="sheet__handle"></view>
  <view class="sheet__title">选择课程</view>
  <scroll-view scroll-y style="max-height:50vh">
    <view wx:for="{{courses}}" wx:key="id" class="pick-row {{item.id === courseId ? 'pick-row--on' : ''}}" hover-class="hover-bg" data-id="{{item.id}}" bindtap="pickCourse">
      <text class="flex-1 ellipsis">{{item.name}}</text>
      <icon wx:if="{{item.id === courseId}}" name="check" size="30rpx" color="#00B8D4" />
    </view>
  </scroll-view>
</view>
