.id-card { margin-bottom: 24rpx; }
.id-card__avatar {
  width: 120rpx; height: 120rpx; border-radius: 9999rpx;
  background: rgba(255,255,255,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; font-weight: 700; color: #fff; overflow: hidden; flex-shrink: 0;
}
.id-card__avatar-img { width: 100%; height: 100%; }
.id-card__name { font-size: 38rpx; font-weight: 700; }
.id-card__meta { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; }

.overview { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 24rpx; }
.overview__cell {
  flex: 1 1 calc(50% - 20rpx); min-width: calc(50% - 20rpx);
  background: var(--ca-card); border: 1rpx solid var(--ca-border);
  border-radius: 16rpx; padding: 24rpx; box-shadow: var(--ca-shadow-card);
}
.overview__num { font-size: 44rpx; font-weight: 700; color: var(--ca-student-hover); }
.overview__unit { font-size: 24rpx; margin-left: 4rpx; }
.overview__lbl { font-size: 24rpx; color: var(--ca-sub); margin-top: 8rpx; }

.achv-grid { display: flex; flex-wrap: wrap; gap: 24rpx; }
.achv { width: calc(20% - 20rpx); text-align: center; opacity: 0.4; }
.achv--on { opacity: 1; }
.achv__icon { font-size: 48rpx; }
.achv__name { font-size: 22rpx; color: var(--ca-sub); margin-top: 8rpx; }
