<view class="page page--tab">
  <block wx:if="{{loading}}">
    <view class="card"><view class="skeleton skeleton-line" style="width:50%"></view><view class="skeleton skeleton-line"></view></view>
  </block>

  <block wx:elif="{{profile}}">
    <!-- 身份卡 -->
    <view class="id-card banner banner--student fade-in">
      <view class="row gap-24">
        <view class="id-card__avatar" hover-class="hover-dim" bindtap="changeAvatar">
          <image wx:if="{{form.avatar_url}}" src="{{form.avatar_url}}" mode="aspectFill" class="id-card__avatar-img" />
          <text wx:else>{{form.nickname[0] || '学'}}</text>
        </view>
        <view class="flex-1">
          <view class="id-card__name">{{form.nickname || '同学'}}</view>
          <view class="id-card__meta">学生{{profile.user.student_no ? ' · 学号 ' + profile.user.student_no : ''}}</view>
          <view class="id-card__meta">{{profile.user.email}}</view>
        </view>
      </view>
    </view>

    <!-- 学习概览 -->
    <view class="overview">
      <view wx:for="{{overview}}" wx:key="label" class="overview__cell">
        <view class="overview__num num">{{item.value}}<text class="overview__unit">{{item.unit}}</text></view>
        <view class="overview__lbl">{{item.label}}</view>
      </view>
    </view>

    <!-- 成就墙 -->
    <view class="section-title">成就墙</view>
    <view class="card">
      <view class="achv-grid">
        <view wx:for="{{achievements}}" wx:key="key" class="achv {{item.unlocked ? 'achv--on' : ''}}">
          <icon class="achv__icon" name="{{item.unlocked ? 'medal' : 'lock'}}" size="48rpx" color="{{item.unlocked ? '#E6A700' : '#999990'}}" />
          <view class="achv__name">{{item.name}}</view>
        </view>
      </view>
    </view>

    <!-- 分组 Tab -->
    <view class="seg-tabs">
      <view class="seg-tabs__item {{tab === 'info' ? 'seg-tabs__item--on' : ''}}" hover-class="hover-dim" data-tab="info" bindtap="switchTab">我的资料</view>
      <view class="seg-tabs__item {{tab === 'archive' ? 'seg-tabs__item--on' : ''}}" hover-class="hover-dim" data-tab="archive" bindtap="switchTab">学习档案</view>
      <view class="seg-tabs__item {{tab === 'account' ? 'seg-tabs__item--on' : ''}}" hover-class="hover-dim" data-tab="account" bindtap="switchTab">账号设置</view>
    </view>

    <!-- 资料 -->
    <view wx:if="{{tab === 'info'}}" class="card">
      <view class="field">
        <view class="field__label">昵称</view>
        <input class="input" value="{{form.nickname}}" data-field="nickname" bindinput="onForm" />
      </view>
      <view class="field">
        <view class="field__label">学校</view>
        <input class="input" value="{{form.school}}" placeholder="选填" data-field="school" bindinput="onForm" />
      </view>
      <view class="field">
        <view class="field__label">个人简介</view>
        <textarea class="textarea" value="{{form.bio}}" placeholder="介绍一下自己" auto-height maxlength="200" cursor-spacing="20" data-field="bio" bindinput="onForm" />
        <view class="text-muted" style="font-size:24rpx;text-align:right;margin-top:8rpx">{{form.bio.length || 0}}/200</view>
      </view>
      <button class="btn btn--primary btn--block" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">保存资料</button>
    </view>

    <!-- 学习档案 -->
    <view wx:elif="{{tab === 'archive'}}" class="card">
      <block wx:if="{{profile.activities.length}}">
        <view wx:for="{{profile.activities}}" wx:key="time" wx:if="{{index < 12}}" class="timeline">
          <view class="timeline__dot"></view>
          <view class="flex-1">
            <view class="ellipsis">{{item.title}}</view>
            <view class="text-muted" style="font-size:24rpx">{{item.meta}}</view>
          </view>
        </view>
      </block>
      <view wx:else class="empty"><view class="empty__text">暂无学习记录</view></view>
    </view>

    <!-- 账号设置 -->
    <view wx:else>
      <view class="card">
        <view class="section-title" style="margin-top:0">通知设置</view>
        <view wx:for="{{notices}}" wx:key="key" class="notice-row">
          <text class="flex-1">{{item.label}}</text>
          <switch checked="{{item.enabled}}" color="#00B8D4" data-index="{{index}}" bindchange="toggleNotice" />
        </view>
      </view>
      <view class="card">
        <view class="list-link" hover-class="hover-bg" bindtap="openPwd"><text class="flex-1">修改密码</text><text class="text-muted">›</text></view>
      </view>
      <button class="btn btn--danger btn--block" bindtap="logout">退出登录</button>
    </view>
  </block>
</view>

<!-- 改密抽屉 -->
<view wx:if="{{pwdOpen}}" class="sheet-mask" bindtap="closePwd"></view>
<view wx:if="{{pwdOpen}}" class="sheet" catchtap="">
  <view class="sheet__handle"></view>
  <view class="sheet__title">修改密码</view>
  <view class="field">
    <view class="field__label">当前密码</view>
    <input class="input" password value="{{pwd.old_password}}" data-field="old_password" bindinput="onPwd" />
  </view>
  <view class="field">
    <view class="field__label">新密码</view>
    <input class="input" password placeholder="至少 8 位" value="{{pwd.new_password}}" data-field="new_password" bindinput="onPwd" />
  </view>
  <view class="field">
    <view class="field__label">确认新密码</view>
    <input class="input" password value="{{pwd.confirm}}" data-field="confirm" bindinput="onPwd" />
  </view>
  <button class="btn btn--primary btn--block mt-8" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitPwd">保存</button>
</view>
