<view class="page page--tab">
  <!-- 问候卡 -->
  <view class="hero banner banner--student fade-in">
    <view class="hero__greeting">{{greeting}}，{{nickname}}</view>
    <view class="hero__sub">基于你的课程数据，今天也一起进步一点点</view>
    <view class="hero__streak" wx:if="{{dashboard.stats.streak_days}}">
      <text class="hero__streak-num num">{{dashboard.stats.streak_days}}</text> 天连续学习
    </view>
  </view>

  <block wx:if="{{loading}}">
    <view class="card"><view class="skeleton skeleton-line" style="width:60%"></view><view class="skeleton skeleton-line"></view><view class="skeleton skeleton-line" style="width:80%"></view></view>
    <view class="card"><view class="skeleton skeleton-line"></view><view class="skeleton skeleton-line" style="width:70%"></view></view>
  </block>

  <block wx:elif="{{dashboard}}">
    <!-- 今日计划 -->
    <view class="card fade-in" bindtap="goPlans">
      <view class="row-between">
        <view class="section-title" style="margin:0">今日计划</view>
        <text class="text-sub">{{todayDone}}/{{todayTotal}} 完成</text>
      </view>
      <block wx:if="{{todayTotal}}">
        <view class="progress mt-16"><view class="progress__bar" style="width:{{todayTotal ? (todayDone/todayTotal*100) : 0}}%"></view></view>
        <view class="task-list mt-16">
          <view wx:for="{{dashboard.today_tasks}}" wx:key="id" wx:if="{{index < 3}}" class="task-row">
            <text class="task-row__dot {{item.status === 'done' ? 'task-row__dot--done' : ''}}">{{item.status === 'done' ? '✓' : '○'}}</text>
            <text class="flex-1 ellipsis {{item.status === 'done' ? 'task-row__done' : ''}}">{{item.title}}</text>
            <text class="text-muted">{{item.estimated_minutes}}分</text>
          </view>
        </view>
      </block>
      <view wx:else class="empty" style="padding:32rpx 0">
        <view class="empty__text">今天还没有学习安排</view>
        <button class="btn btn--primary btn--sm" catchtap="goPlans">制定计划</button>
      </view>
    </view>

    <!-- 继续学习 / 加入课程 -->
    <block wx:if="{{dashboard.continue_learning}}">
      <view class="card continue fade-in">
        <view class="tag tag--ai">继续学习</view>
        <view class="continue__title clamp-2">{{dashboard.continue_learning.lesson.title}}</view>
        <view class="text-sub mt-8">{{dashboard.continue_learning.course.name}}</view>
        <view class="progress mt-16"><view class="progress__bar" style="width:{{continueProgress}}%"></view></view>
        <view class="row-between mt-8">
          <text class="text-muted">已学 {{continueProgress}}%</text>
        </view>
        <button class="btn btn--primary btn--block mt-16" bindtap="continueLearning">继续学习</button>
      </view>
    </block>
    <view wx:else class="card empty fade-in">
      <view class="empty__icon">📚</view>
      <view class="empty__text">还没有加入课程</view>
      <button class="btn btn--primary btn--sm" bindtap="goCourses">加入课程</button>
    </view>

    <!-- 我的课程 横向 -->
    <block wx:if="{{dashboard.courses.length}}">
      <view class="section-title">我的课程</view>
      <scroll-view scroll-x class="course-scroll" enhanced show-scrollbar="{{false}}">
        <view wx:for="{{dashboard.courses}}" wx:key="id" class="course-chip" data-id="{{item.id}}" bindtap="openCourse">
          <view class="course-chip__name clamp-2">{{item.name}}</view>
          <view class="text-muted" style="font-size:24rpx">{{item.teacher.nickname || '教师'}}</view>
          <view class="progress mt-16"><view class="progress__bar" style="width:{{item.progress_percent}}%"></view></view>
          <view class="text-muted mt-8" style="font-size:24rpx">{{item.completed_lessons}}/{{item.lesson_total}} 课时</view>
        </view>
      </scroll-view>
    </block>

    <!-- 学习数据 -->
    <view class="section-title">学习数据</view>
    <view class="stats-grid">
      <view wx:for="{{statsView}}" wx:key="label" class="stat-card">
        <view class="stat-card__value num">{{item.value}}<text class="stat-card__unit">{{item.unit}}</text></view>
        <view class="stat-card__label">{{item.label}}</view>
      </view>
    </view>

    <!-- AI 今日推荐 -->
    <view class="section-title">AI 今日推荐</view>
    <view class="card ai-card fade-in">
      <view class="row gap-8">
        <text class="ai-card__spark">✦</text>
        <text class="tag tag--ai">基于课程数据</text>
      </view>
      <view class="text-body mt-16" wx:if="{{dashboard.recommendation.text}}">{{dashboard.recommendation.text}}</view>
      <view class="text-sub mt-16" wx:else>加入课程后，AI 会根据你的学习记录给出推荐。</view>
      <view wx:if="{{weakPoints.length}}" class="weak-row mt-16">
        <text wx:for="{{weakPoints}}" wx:key="name" class="tag tag--warning" style="margin-right:12rpx;margin-bottom:8rpx">{{item.name}}</text>
      </view>
      <view class="row gap-16 mt-16" wx:if="{{dashboard.recommendation.lesson}}">
        <button class="btn btn--outline btn--sm flex-1" bindtap="openRecommendLesson">推荐课时</button>
        <button class="btn btn--primary btn--sm flex-1" bindtap="goQa">问问 AI</button>
      </view>
    </view>

    <!-- 学习动态 -->
    <block wx:if="{{dashboard.activities.length}}">
      <view class="section-title">学习动态</view>
      <view class="card">
        <view wx:for="{{dashboard.activities}}" wx:key="index" wx:if="{{index < 6}}" class="activity-row">
          <text class="activity-row__type activity-row__type--{{item.type}}">{{item.meta}}</text>
          <text class="flex-1 ellipsis">{{item.title}}</text>
        </view>
      </view>
    </block>
  </block>
</view>
