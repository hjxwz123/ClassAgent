<view class="qa">
  <!-- 顶部栏 -->
  <view class="qa__top">
    <view class="qa__top-left">
      <view wx:if="{{backCourseId}}" class="qa__back" hover-class="hover-dim" bindtap="backToCourse">‹</view>
      <view class="course-sel" hover-class="hover-dim" bindtap="toggleCoursePicker">
        <text class="ellipsis">{{courseName}}</text>
        <icon class="course-sel__arrow" name="chevron-down" size="24rpx" color="#0097A7" />
      </view>
    </view>
    <view class="qa__actions">
      <text class="qa__action" hover-class="hover-dim" bindtap="goTutoring">题目辅导</text>
      <text class="qa__action" hover-class="hover-dim" bindtap="newConversation">新对话</text>
      <text class="qa__action" hover-class="hover-dim" bindtap="openHistory">历史</text>
    </view>
  </view>

  <!-- 对话区 -->
  <scroll-view scroll-y class="qa__scroll" scroll-top="{{scrollTop}}" scroll-with-animation>
    <!-- 空状态 -->
    <view wx:if="{{!messages.length}}" class="qa__empty">
      <icon class="qa__welcome-icon" name="spark" size="72rpx" color="#00E5FF" />
      <view class="qa__welcome">课程专属 AI 问答</view>
      <view class="text-sub">回答基于本课程的课件与学习记录</view>
      <view class="prompt-grid">
        <view wx:for="{{prompts}}" wx:key="*this" class="prompt-card" hover-class="hover-bg" data-text="{{item}}" bindtap="usePrompt">{{item}}</view>
      </view>
    </view>

    <view wx:for="{{messages}}" wx:key="k" id="msg-{{index}}" class="msg msg--{{item.role}}">
      <!-- 用户消息 -->
      <block wx:if="{{item.role === 'user'}}">
        <view class="bubble bubble--user">
          <view wx:if="{{item.attachments.length}}" class="bubble__imgs">
            <image wx:for="{{item.attachments}}" wx:for-item="att" wx:for-index="attIndex" wx:key="url" src="{{att.displayUrl || att.url}}" mode="aspectFill" lazy-load class="bubble__img" data-index="{{attIndex}}" data-list="{{item.attachments}}" bindtap="previewAttachment" />
          </view>
          <text user-select>{{item.text}}</text>
        </view>
      </block>
      <!-- AI 消息 -->
      <block wx:else>
        <view class="msg__ai-head"><icon class="msg__ai-spark" name="spark" size="26rpx" color="#00E5FF" /> AI 助教</view>
        <view class="bubble bubble--ai {{item.error ? 'bubble--error' : ''}}">
          <block wx:if="{{item.pending}}">
            <view class="typing"><text></text><text></text><text></text></view>
            <view wx:if="{{item.statusText}}" class="stage-text">{{item.statusText}}</view>
          </block>
          <block wx:else>
            <view wx:if="{{item.outOfScope}}" class="scope-hint">问题可能超出本课程范围，以下回答仅供参考</view>
            <view wx:if="{{item.thinking}}" class="thinking-toggle" hover-class="hover-dim" data-index="{{index}}" bindtap="toggleThinking">
              <text>{{item.showThinking ? '收起思考过程' : '查看思考过程'}}</text>
              <icon name="{{item.showThinking ? 'chevron-up' : 'chevron-down'}}" size="22rpx" color="#0097A7" />
            </view>
            <view wx:if="{{item.thinking && item.showThinking}}" class="thinking-box">{{item.thinking}}</view>
            <!-- 流式中按纯文本逐字上屏；结束后按 markdown 排版渲染 -->
            <rich-text wx:if="{{item.nodes && !item.streaming}}" class="bubble__rich" nodes="{{item.nodes}}" user-select></rich-text>
            <text wx:else class="bubble__text" user-select>{{item.text}}</text>
            <view wx:if="{{item.streaming}}" class="stream-cursor"></view>
            <view wx:if="{{item.sources.length}}" class="sources">
              <view class="sources__title">参考来源</view>
              <view wx:for="{{item.sources}}" wx:for-item="src" wx:for-index="srcIndex" wx:key="srcIndex" class="sources__item ellipsis">· {{src.title || src.snippet || src.page_title || '课件片段'}}</view>
            </view>
            <view wx:if="{{item.error}}" class="msg__tools">
              <text class="msg__tool msg__tool--retry" hover-class="hover-dim" data-index="{{index}}" bindtap="retry">重新提问</text>
            </view>
            <view wx:if="{{!item.error && !item.streaming && item.text}}" class="msg__tools">
              <text class="msg__tool" hover-class="hover-dim" data-text="{{item.text}}" bindtap="copyAnswer">复制</text>
              <text class="msg__tool {{item.favorite ? 'msg__tool--on' : ''}}" hover-class="hover-dim" data-index="{{index}}" bindtap="favorite">{{item.favorite ? '已收藏' : '收藏'}}</text>
              <view class="msg__tool {{item.feedback === 'positive' ? 'msg__tool--on' : ''}}" hover-class="hover-dim" data-index="{{index}}" data-value="positive" bindtap="feedback"><icon name="thumb-up" size="30rpx" color="{{item.feedback === 'positive' ? '#0097A7' : '#666560'}}" /></view>
              <view class="msg__tool {{item.feedback === 'negative' ? 'msg__tool--on' : ''}}" hover-class="hover-dim" data-index="{{index}}" data-value="negative" bindtap="feedback"><icon name="thumb-down" size="30rpx" color="{{item.feedback === 'negative' ? '#0097A7' : '#666560'}}" /></view>
            </view>
          </block>
        </view>
      </block>
    </view>
    <view style="height:20rpx"></view>
  </scroll-view>

  <!-- 输入区 -->
  <view class="qa__input-wrap">
    <view class="qa__input">
      <textarea class="qa__textarea" placeholder="向 AI 提问…" value="{{input}}" bindinput="onInput" auto-height maxlength="2000" cursor-spacing="20" show-confirm-bar="{{false}}" confirm-type="send" bindconfirm="send" />
      <button wx:if="{{sending}}" class="qa__send qa__send--stop" bindtap="stopGeneration">
        <view class="qa__stop-square"></view>
      </button>
      <button wx:else class="qa__send {{input ? 'qa__send--on' : ''}}" disabled="{{!input}}" bindtap="send">
        <icon name="send" size="40rpx" color="{{input ? '#ffffff' : '#999990'}}" />
      </button>
    </view>
  </view>
</view>

<!-- 课程选择 -->
<view wx:if="{{coursePickerOpen}}" class="sheet-mask" bindtap="toggleCoursePicker"></view>
<view wx:if="{{coursePickerOpen}}" class="sheet sheet--tab" catchtap="">
  <view class="sheet__handle"></view>
  <view class="sheet__title">选择课程</view>
  <scroll-view scroll-y style="max-height:50vh">
    <view wx:for="{{courses}}" wx:key="id" class="pick-row {{item.id === courseId ? 'pick-row--on' : ''}}" hover-class="hover-bg" data-id="{{item.id}}" bindtap="pickCourse">
      <text class="flex-1 ellipsis">{{item.name}}</text>
      <icon wx:if="{{item.id === courseId}}" name="check" size="30rpx" color="#00B8D4" />
    </view>
    <view wx:if="{{!courses.length}}" class="empty">
      <view class="empty__text">还没有加入课程</view>
      <button class="btn btn--primary btn--sm" bindtap="goJoinCourse">去加入课程</button>
    </view>
  </scroll-view>
</view>

<!-- 历史 -->
<view wx:if="{{historyOpen}}" class="sheet-mask" bindtap="closeHistory"></view>
<view wx:if="{{historyOpen}}" class="sheet sheet--tab" catchtap="">
  <view class="sheet__handle"></view>
  <view class="sheet__title">问答历史</view>
  <scroll-view scroll-y style="max-height:60vh">
    <view wx:if="{{historyLoading}}" class="empty"><view class="empty__text">加载中…</view></view>
    <block wx:elif="{{history.length}}">
      <view wx:for="{{history}}" wx:key="conversation_id" class="hist-row" hover-class="hover-bg" data-id="{{item.conversation_id}}" bindtap="openConversation">
        <view class="ellipsis" style="font-weight:600">{{item.title || item.question}}</view>
        <view class="text-muted ellipsis" style="font-size:24rpx;margin-top:6rpx">{{item.answer_preview}}</view>
      </view>
    </block>
    <view wx:else class="empty"><view class="empty__text">本课程暂无问答记录</view></view>
  </scroll-view>
</view>
