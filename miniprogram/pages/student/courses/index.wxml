<view class="page page--tab">
  <view class="row-between">
    <view class="h1">我的课程</view>
    <button class="btn btn--primary btn--sm" bindtap="openJoin">+ 加入课程</button>
  </view>

  <view class="search mt-16">
    <icon class="search__icon" name="search" size="28rpx" color="#999990" />
    <input class="search__input" placeholder="搜索课程名称" confirm-type="search" value="{{keyword}}" bindinput="onSearch" />
  </view>

  <view class="chips mt-16">
    <view class="chip {{filter === 'all' ? 'chip--on' : ''}}" hover-class="hover-bg" data-filter="all" bindtap="setFilter">全部</view>
    <view class="chip {{filter === 'active' ? 'chip--on' : ''}}" hover-class="hover-bg" data-filter="active" bindtap="setFilter">在学中</view>
    <view class="chip {{filter === 'done' ? 'chip--on' : ''}}" hover-class="hover-bg" data-filter="done" bindtap="setFilter">已完成</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="card"><view class="skeleton skeleton-line" style="width:50%"></view><view class="skeleton skeleton-line"></view></view>
  </block>

  <!-- 加载失败占位 -->
  <block wx:elif="{{error}}">
    <view class="empty">
      <icon class="empty__icon" name="cross" size="64rpx" color="#C62828" />
      <view class="empty__text">加载失败，请检查网络后重试</view>
      <button class="btn btn--primary btn--sm" bindtap="retryLoad">重新加载</button>
    </view>
  </block>

  <block wx:elif="{{filtered.length}}">
    <view wx:for="{{filtered}}" wx:key="id" class="card course-card fade-in" hover-class="hover-card" data-id="{{item.id}}" bindtap="openCourse">
      <view class="row-between">
        <view class="flex-1">
          <view class="course-card__name clamp-2">{{item.name}}</view>
          <view class="text-sub mt-8">{{item.teacher.nickname || '教师'}} · {{item.term}}</view>
        </view>
        <view class="tag tag--code" hover-class="hover-dim" catchtap="copyCode" data-code="{{item.course_code}}">{{item.course_code}}</view>
      </view>

      <view class="progress mt-16"><view class="progress__bar" style="width:{{item.progress_percent}}%"></view></view>
      <view class="row-between mt-8">
        <text class="text-muted">已学 {{item.completed_lessons}}/{{item.lesson_total}} 课时</text>
        <text class="text-muted">{{item.progress_percent}}%</text>
      </view>

      <view class="course-card__meta mt-16">
        <text class="text-sub">问答 {{item.qa_count}}</text>
        <text class="text-sub">错题 {{item.wrong_count}}</text>
      </view>

      <view class="row gap-16 mt-16">
        <button class="btn btn--primary btn--sm flex-1" catchtap="openCourse" data-id="{{item.id}}">
          {{item.progress_percent > 0 ? '继续学习' : '开始学习'}}
        </button>
        <button class="btn btn--outline btn--sm" catchtap="goQa" data-id="{{item.id}}">问答</button>
        <button class="btn btn--outline btn--sm" catchtap="leaveCourse" data-id="{{item.id}}">退出</button>
      </view>
    </view>
  </block>

  <view wx:else class="empty">
    <icon class="empty__icon" name="book" size="64rpx" color="#00B8D4" />
    <view class="empty__text">{{keyword ? '没有匹配的课程' : '还没有加入课程'}}</view>
    <button wx:if="{{!keyword}}" class="btn btn--primary btn--sm" bindtap="openJoin">加入课程</button>
  </view>
</view>

<!-- 加入课程抽屉 -->
<view wx:if="{{joinOpen}}" class="sheet-mask" bindtap="closeJoin"></view>
<view wx:if="{{joinOpen}}" class="sheet sheet--tab" catchtap="">
  <view class="sheet__handle"></view>
  <view class="sheet__title">加入课程</view>
  <view class="field">
    <view class="field__label">课程码</view>
    <input class="input code-input {{joinError ? 'input--error' : ''}}" placeholder="输入 6 位课程码" maxlength="12" value="{{joinCode}}" bindinput="onJoinInput" bindconfirm="validateCode" />
    <view wx:if="{{joinError}}" class="field__error">{{joinError}}</view>
  </view>

  <view wx:if="{{joinPreview && joinPreview.course}}" class="join-preview">
    <view class="h2">{{joinPreview.course.name}}</view>
    <view class="text-sub mt-8">{{joinPreview.teacher.nickname || '教师'}} · {{joinPreview.course.term}}</view>
    <view class="text-sub mt-8">{{joinPreview.student_count}} 名同学 · {{joinPreview.lesson_count}} 个课时</view>
  </view>

  <button wx:if="{{!joinPreview}}" class="btn btn--primary btn--block mt-16" loading="{{joinChecking}}" bindtap="validateCode">校验课程码</button>
  <button wx:elif="{{!joinPreview.already_joined}}" class="btn btn--primary btn--block mt-16" loading="{{joining}}" disabled="{{joining}}" bindtap="confirmJoin">确认加入</button>
  <button wx:else class="btn btn--outline btn--block mt-16" bindtap="closeJoin">已在课程中</button>
</view>
