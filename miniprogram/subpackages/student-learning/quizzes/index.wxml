<view class="page">
  <!-- 顶部卡 -->
  <view class="banner banner--student fade-in">
    <view class="quiz-top">
      <view class="quiz-top__cell"><view class="num">{{quizzes.length}}</view><text>课程测验</text></view>
      <view class="quiz-top__cell"><view class="num">{{chapters.length}}</view><text>可练章节</text></view>
      <view class="quiz-top__cell" hover-class="hover-dim" bindtap="retryWrong"><view class="num">{{wrongCount}}</view><text>待重练</text></view>
    </view>
  </view>

  <view class="seg-tabs">
    <view class="seg-tabs__item {{tab === 'quiz' ? 'seg-tabs__item--on' : ''}}" hover-class="hover-dim" data-tab="quiz" bindtap="switchTab">课程测验</view>
    <view class="seg-tabs__item {{tab === 'practice' ? 'seg-tabs__item--on' : ''}}" hover-class="hover-dim" data-tab="practice" bindtap="switchTab">章节练习</view>
  </view>

  <!-- 课程测验 -->
  <block wx:if="{{tab === 'quiz'}}">
    <block wx:if="{{loading}}">
      <view class="card"><view class="skeleton skeleton-line"></view></view>
    </block>
    <view wx:elif="{{error}}" class="empty">
      <icon class="empty__icon" name="cross" size="64rpx" color="#C62828" />
      <view class="empty__text">加载失败，请检查网络后重试</view>
      <button class="btn btn--outline btn--sm" bindtap="load">重新加载</button>
    </view>
    <block wx:elif="{{quizzes.length}}">
      <view wx:for="{{quizzes}}" wx:key="id" class="card quiz-card fade-in">
        <view class="row-between">
          <view class="flex-1">
            <view class="ellipsis" style="font-weight:600;font-size:32rpx">{{item.title}}</view>
            <view class="text-muted mt-8" style="font-size:24rpx">{{item.total_score}} 分 · {{item.quiz_type === 'practice' ? '练习' : '测验'}}</view>
          </view>
          <text class="tag {{item.attempted ? 'tag--success' : 'tag--info'}}">{{item.attempted ? '已完成 ' + item.scoreText : '未作答'}}</text>
        </view>
        <view class="row gap-16 mt-16">
          <button wx:if="{{item.attempted}}" class="btn btn--outline btn--sm flex-1" data-id="{{item.id}}" bindtap="viewResult">查看解析</button>
          <button class="btn btn--primary btn--sm flex-1" data-id="{{item.id}}" bindtap="openQuiz">{{item.attempted ? '再次作答' : '开始作答'}}</button>
        </view>
      </view>
    </block>
    <view wx:else class="empty"><icon class="empty__icon" name="note" size="64rpx" color="#00B8D4" /><view class="empty__text">本课程暂无测验</view></view>
  </block>

  <!-- 章节练习 -->
  <block wx:else>
    <view class="card">
      <view class="section-title" style="margin-top:0">选择章节（单选）</view>
      <view class="chips" wx:if="{{chapters.length}}">
        <view wx:for="{{chapters}}" wx:key="id" class="chip {{selectedChapter === item.id ? 'chip--on' : ''}}" hover-class="hover-dim" data-id="{{item.id}}" bindtap="toggleChapter">{{item.title}}</view>
      </view>
      <view wx:else class="text-muted">本课程暂无章节，可直接生成全课程练习</view>

      <view class="section-title">题量</view>
      <view class="chips">
        <view wx:for="{{counts}}" wx:key="*this" class="chip {{count === item ? 'chip--on' : ''}}" hover-class="hover-dim" data-count="{{item}}" bindtap="setCount">{{item}} 题</view>
      </view>

      <view class="notice-row mt-16">
        <text class="flex-1">优先薄弱知识点</text>
        <switch checked="{{preferWeak}}" color="#00B8D4" bindchange="toggleWeak" />
      </view>

      <button class="btn btn--primary btn--block mt-16" loading="{{generating}}" disabled="{{generating}}" bindtap="generate"><icon name="spark" size="28rpx" color="#ffffff" /> 智能生成练习</button>
    </view>
  </block>
</view>
