.exam { height: 100vh; display: flex; flex-direction: column; background: var(--ca-bg); }

.exam__nav { background: var(--ca-card); border-bottom: 1rpx solid var(--ca-border); }
.exam__nav-bar { display: flex; align-items: center; height: 88rpx; padding: 0 32rpx; }
.exam__exit { width: 100rpx; font-size: 28rpx; color: var(--ca-sub); }
.exam__title { flex: 1; text-align: center; font-size: 30rpx; font-weight: 600; }
.exam__time { width: 100rpx; text-align: right; font-size: 28rpx; color: var(--ca-student-hover); }
.exam__progress { height: 6rpx; background: var(--ca-border); }
.exam__progress-bar { height: 100%; background: var(--ca-student); transition: width 0.2s; }

.exam__loading { flex: 1; display: flex; align-items: center; justify-content: center; color: var(--ca-muted); }

/* 加载失败占位 */
.exam__error { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; padding: 0 64rpx; }
.exam__error-text { font-size: 28rpx; color: var(--ca-sub); margin-bottom: 8rpx; }

.exam__body { flex: 1; padding: 32rpx; }
.exam__stem { font-size: 34rpx; line-height: 1.6; color: var(--ca-ink); margin: 24rpx 0; font-weight: 500; }

.opt {
  display: flex; align-items: center; gap: 20rpx;
  padding: 28rpx 24rpx; margin-bottom: 20rpx;
  background: var(--ca-card); border: 2rpx solid var(--ca-border); border-radius: 16rpx;
  font-size: 30rpx; line-height: 1.5;
}
.opt--on { border-color: var(--ca-student); background: var(--ca-student-light); }
.opt__letter {
  width: 56rpx; height: 56rpx; border-radius: 9999rpx; flex-shrink: 0;
  background: var(--ca-bg); color: var(--ca-sub);
  display: flex; align-items: center; justify-content: center; font-weight: 600;
}
.opt--on .opt__letter { background: var(--ca-student); color: #fff; }
.opt__check { color: var(--ca-student-hover); font-weight: 700; }

.exam__foot {
  display: flex; align-items: center; gap: 20rpx;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: var(--ca-card); border-top: 1rpx solid var(--ca-border);
}
.exam__foot-btn { flex: 1; text-align: center; height: 80rpx; line-height: 80rpx; border-radius: 12rpx; background: var(--ca-bg); color: var(--ca-ink-soft); font-size: 30rpx; }
.exam__foot-btn--primary { background: var(--ca-student); color: #fff; font-weight: 600; }
.exam__foot-btn--disabled { opacity: 0.5; pointer-events: none; }
.exam__foot-panel { width: 140rpx; text-align: center; height: 80rpx; line-height: 80rpx; border-radius: 12rpx; border: 1rpx solid var(--ca-border); font-size: 28rpx; color: var(--ca-sub); }

.num-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.num-cell {
  width: calc(16.66% - 17rpx); height: 80rpx; line-height: 80rpx; text-align: center;
  border-radius: 12rpx; background: var(--ca-bg); border: 1rpx solid var(--ca-border); font-size: 28rpx;
}
.num-cell--done { background: var(--ca-student-light); border-color: var(--ca-student); color: var(--ca-student-hover); }
.num-cell--cur { background: var(--ca-student); border-color: var(--ca-student); color: #fff; font-weight: 700; }
