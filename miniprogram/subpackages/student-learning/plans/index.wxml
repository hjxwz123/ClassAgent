<view class="page">
  <block wx:if="{{loading}}">
    <view class="card"><view class="skeleton skeleton-line"></view></view>
  </block>

  <block wx:else>
    <!-- 横幅 -->
    <view class="banner banner--student fade-in plan-banner">
      <view class="plan-banner__cell"><view class="num">{{stats.monthCheckin}}</view><text>本月打卡</text></view>
      <view class="plan-banner__cell"><view class="num">{{stats.done}}</view><text>已完成任务</text></view>
      <view class="plan-banner__cell"><view class="num">{{stats.total}}</view><text>计划任务</text></view>
    </view>

    <!-- 无计划状态 -->
    <view wx:if="{{!plan}}" class="card empty fade-in">
      <view class="empty__icon">🗓</view>
      <view class="empty__text">今天还没有学习安排</view>
      <button class="btn btn--primary btn--sm" bindtap="openGen">制定计划</button>
    </view>

    <block wx:else>
      <!-- 今日任务 -->
      <view class="section-title">今日任务</view>
      <view class="card" wx:if="{{todayTasks.length}}">
        <view wx:for="{{todayTasks}}" wx:key="id" class="plan-task">
          <view class="flex-1">
            <view class="{{item.status === 'done' ? 'plan-task--done' : ''}}">{{item.title}}</view>
            <view class="text-muted" style="font-size:24rpx">{{item.task_type}} · {{item.estimated_minutes}} 分钟</view>
          </view>
          <button wx:if="{{item.status !== 'done'}}" class="btn btn--primary btn--sm" data-id="{{item.id}}" bindtap="checkin">打卡</button>
          <text wx:else class="tag tag--success">已完成</text>
        </view>
      </view>
      <view wx:else class="card text-sub">今天没有计划任务，继续保持～</view>

      <!-- 月历 -->
      <view class="row-between">
        <view class="section-title" style="margin:0">{{monthLabel}}</view>
        <text class="text-student" style="font-size:26rpx" bindtap="openGen">重新规划</text>
      </view>
      <view class="card calendar">
        <view class="calendar__week">
          <text wx:for="{{weekDays}}" wx:key="*this" class="calendar__wd">{{item}}</text>
        </view>
        <view class="calendar__grid">
          <view wx:for="{{calendar}}" wx:key="key" class="cal-cell {{item.isToday ? 'cal-cell--today' : ''}} {{item.done ? 'cal-cell--done' : ''}}">
            <text wx:if="{{!item.blank}}">{{item.day}}</text>
            <view wx:if="{{item.hasTask && !item.done}}" class="cal-cell__dot"></view>
          </view>
        </view>
      </view>
    </block>
  </block>
</view>

<!-- AI 生成计划 -->
<view wx:if="{{genOpen}}" class="sheet-mask" bindtap="closeGen"></view>
<view wx:if="{{genOpen}}" class="sheet" catchtap="">
  <view class="sheet__handle"></view>
  <view class="sheet__title">AI 制定学习计划</view>
  <view class="field">
    <view class="field__label">学习目标</view>
    <textarea class="textarea" style="min-height:140rpx" placeholder="例如：两周内掌握本课程前三章" value="{{form.goal}}" bindinput="onGoal" />
  </view>
  <view class="field">
    <view class="field__label">每日学习分钟数</view>
    <input class="input" type="number" value="{{form.daily_minutes}}" bindinput="onMinutes" />
  </view>
  <view class="field">
    <view class="field__label">计划周期（天）</view>
    <input class="input" type="number" value="{{form.available_days}}" bindinput="onDays" />
  </view>
  <button class="btn btn--primary btn--block mt-8" loading="{{generating}}" bindtap="generate">✦ 生成计划</button>
</view>
