<view class="page">
  <view class="course-sel" bindtap="toggleCoursePicker">
    <text class="ellipsis">{{courseName}}</text>
    <icon class="course-sel__arrow" name="chevron-down" size="24rpx" color="#0097A7" />
  </view>

  <!-- 输入模式 -->
  <view class="seg-tabs mt-16">
    <view class="seg-tabs__item {{mode === 'text' ? 'seg-tabs__item--on' : ''}}" data-mode="text" bindtap="setMode">文字输入</view>
    <view class="seg-tabs__item {{mode === 'image' ? 'seg-tabs__item--on' : ''}}" data-mode="image" bindtap="setMode">图片上传</view>
  </view>

  <view class="card">
    <block wx:if="{{mode === 'text'}}">
      <textarea class="textarea" style="min-height:220rpx" placeholder="输入或粘贴题目，AI 会分步引导你解题" value="{{text}}" bindinput="onText" maxlength="3000" />
      <button class="btn btn--primary btn--block mt-16" loading="{{submitting}}" bindtap="submitText">获取辅导</button>
    </block>
    <block wx:else>
      <view class="upload-zone" bindtap="chooseImage">
        <icon class="upload-zone__icon" name="camera" size="72rpx" color="#00B8D4" />
        <view class="text-sub">拍照或从相册选择题目图片</view>
        <view class="text-muted" style="font-size:24rpx;margin-top:8rpx">支持拍照识别题干（OCR）</view>
      </view>
    </block>
  </view>

  <!-- 题目与辅导 -->
  <block wx:if="{{problem}}">
    <view class="card fade-in">
      <view class="text-sub">题目</view>
      <view class="text-body mt-8">{{problem.corrected_text || problem.ocr_text || problem.raw_text}}</view>
      <view wx:if="{{problem.knowledge_points.length}}" class="mt-16">
        <text wx:for="{{problem.knowledge_points}}" wx:key="*this" class="tag tag--ai" style="margin-right:12rpx;margin-bottom:8rpx">{{item.name || item}}</text>
      </view>
    </view>

    <view class="section-title">分步辅导</view>
    <view wx:for="{{steps}}" wx:key="level" class="card step-card">
      <view class="row-between" data-level="{{item.level}}" bindtap="loadGuidance">
        <view>
          <view style="font-weight:600">{{item.name}}</view>
          <view class="text-muted" style="font-size:24rpx">{{item.hint}}</view>
        </view>
        <text wx:if="{{loadingLevel === item.level}}" class="text-muted">…</text>
        <icon wx:else name="{{openLevel[item.level] ? 'chevron-up' : 'chevron-down'}}" size="24rpx" color="#999990" />
      </view>
      <view wx:if="{{openLevel[item.level]}}" class="step-card__content">{{guidance[item.level]}}</view>
    </view>
  </block>

  <!-- 历史 -->
  <block wx:if="{{history.length}}">
    <view class="section-title">历史辅导</view>
    <view wx:for="{{history}}" wx:key="id" class="card hist-card" data-id="{{item.id}}" bindtap="openHistory">
      <view class="clamp-2">{{item.corrected_text || item.ocr_text || item.raw_text}}</view>
      <view class="text-muted mt-8" style="font-size:24rpx">{{item.source_type === 'image' ? '图片' : '文字'}}</view>
    </view>
  </block>
</view>

<!-- 课程选择 -->
<view wx:if="{{coursePickerOpen}}" class="sheet-mask" bindtap="toggleCoursePicker"></view>
<view wx:if="{{coursePickerOpen}}" class="sheet" catchtap="">
  <view class="sheet__handle"></view>
  <view class="sheet__title">选择课程</view>
  <scroll-view scroll-y style="max-height:50vh">
    <view wx:for="{{courses}}" wx:key="id" class="pick-row {{item.id === courseId ? 'pick-row--on' : ''}}" data-id="{{item.id}}" bindtap="pickCourse">
      <text class="flex-1 ellipsis">{{item.name}}</text>
      <icon wx:if="{{item.id === courseId}}" name="check" size="30rpx" color="#00B8D4" />
    </view>
  </scroll-view>
</view>
