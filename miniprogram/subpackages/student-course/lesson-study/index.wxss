.study { height: 100vh; background: #121614; display: flex; flex-direction: column; position: relative; }

.study__nav { background: #121614; }
.study__nav-bar { display: flex; align-items: center; height: 88rpx; padding: 0 24rpx; }
.study__back { width: 64rpx; font-size: 56rpx; color: #F4F4F0; line-height: 1; }
.study__title { flex: 1; text-align: center; color: #F4F4F0; }
.study__title .ellipsis { font-size: 30rpx; font-weight: 600; max-width: 420rpx; margin: 0 auto; }
.study__sub { font-size: 22rpx; color: #8C948F; margin-top: 2rpx; }
.study__set { width: 80rpx; text-align: right; font-size: 26rpx; color: #00E5FF; }

.study__loading { flex: 1; display: flex; align-items: center; justify-content: center; color: #8C948F; font-size: 28rpx; }

.stage { flex: 1; }
.stage__scroll { height: 100%; }
.slide { min-height: 100%; padding: 40rpx 40rpx 200rpx; }
.slide__title { font-size: 40rpx; font-weight: 700; color: #F4F4F0; margin-bottom: 24rpx; }
.slide__body { font-size: 32rpx; line-height: 1.8; color: #DEDEDA; white-space: pre-wrap; }

.subtitle {
  position: absolute;
  left: 32rpx; right: 32rpx; bottom: 240rpx;
  background: rgba(0,0,0,0.55);
  color: #F4F4F0;
  font-size: 28rpx;
  line-height: 1.6;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
}

.controls {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #1a201d;
  border-top: 1rpx solid #2a312d;
}
.controls__btn { color: #DEDEDA; font-size: 28rpx; padding: 12rpx 20rpx; }
.controls__btn--primary { color: #00E5FF; font-weight: 600; }
.controls__center { display: flex; gap: 24rpx; }
.controls__icon {
  width: 72rpx; height: 72rpx; border-radius: 9999rpx;
  background: rgba(0,229,255,0.14); color: #00E5FF;
  display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600;
}

.handle { padding: 12rpx 0 calc(env(safe-area-inset-bottom) + 12rpx); text-align: center; color: #8C948F; font-size: 22rpx; background: #1a201d; }
.handle__bar { width: 72rpx; height: 8rpx; border-radius: 9999rpx; background: #3a423d; margin: 0 auto 8rpx; }

/* 抽屉 */
.drawer {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 201;
  height: 64vh; background: var(--ca-card);
  border-radius: 28rpx 28rpx 0 0; box-shadow: var(--ca-shadow-sheet);
  display: flex; flex-direction: column;
  padding: 16rpx 0 0;
  animation: caSheetUp 0.26s ease;
}
.drawer__tabs { display: flex; padding: 0 32rpx; border-bottom: 1rpx solid var(--ca-border); }
.drawer__tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: var(--ca-sub); }
.drawer__tab--on { color: var(--ca-student-hover); font-weight: 600; border-bottom: 4rpx solid var(--ca-student); }
.drawer__body { flex: 1; padding: 24rpx 32rpx; }
.drawer__text { font-size: 30rpx; line-height: 1.8; color: var(--ca-ink-soft); white-space: pre-wrap; }

.act-card { background: var(--ca-bg); border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; border-left: 6rpx solid var(--ca-student); }
.act-card--mistake { border-left-color: var(--ca-accent); background: var(--ca-warning-bg); }
.act-card--example { border-left-color: var(--ca-info); }
.act-card__title { font-size: 30rpx; font-weight: 600; margin-top: 12rpx; }

.dqa { margin-bottom: 20rpx; }
.dqa--user { display: flex; justify-content: flex-end; }
.dqa__bubble { max-width: 84%; padding: 18rpx 24rpx; border-radius: 24rpx; font-size: 28rpx; line-height: 1.6; }
.dqa__bubble--user { background: var(--ca-student-light); }
.dqa__bubble--ai { background: var(--ca-bg); border: 1rpx solid var(--ca-border); }
.dqa__bubble--err { background: var(--ca-error-bg); color: var(--ca-error); }

.note-state { font-size: 24rpx; }
.note-state--ok { color: var(--ca-success); }
.note-state--err { color: var(--ca-accent); }

.drawer__input { display: flex; align-items: flex-end; gap: 16rpx; padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 16rpx); border-top: 1rpx solid var(--ca-border); }

.thumb-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.thumb { width: calc(33.33% - 14rpx); background: var(--ca-bg); border: 1rpx solid var(--ca-border); border-radius: 12rpx; padding: 16rpx; }
.thumb--on { border-color: var(--ca-student); background: var(--ca-student-light); }
.thumb__num { font-size: 24rpx; color: var(--ca-sub); }
.thumb__title { font-size: 24rpx; margin-top: 8rpx; height: 64rpx; }

.complete {
  position: fixed; left: 48rpx; right: 48rpx; top: 50%; z-index: 202;
  transform: translateY(-50%);
  background: var(--ca-card); border-radius: 28rpx; padding: 48rpx 40rpx; text-align: center;
}
.complete__icon { font-size: 80rpx; }
.complete__title { font-size: 38rpx; font-weight: 700; margin: 16rpx 0 32rpx; }
.complete__stats { display: flex; justify-content: space-around; }
.complete__stat { display: flex; flex-direction: column; align-items: center; }
.complete__stat .num { font-size: 48rpx; font-weight: 700; color: var(--ca-student-hover); }
.complete__stat text { font-size: 24rpx; color: var(--ca-sub); margin-top: 4rpx; }

.qa__textarea { flex: 1; min-height: 72rpx; max-height: 200rpx; padding: 18rpx 24rpx; background: var(--ca-bg); border-radius: 24rpx; font-size: 30rpx; }
.qa__send { height: 72rpx; line-height: 72rpx; padding: 0 28rpx; border-radius: 9999rpx; background: var(--ca-border); color: var(--ca-muted); font-size: 28rpx; }
.qa__send::after { border: none; }
.qa__send--on { background: var(--ca-student); color: #fff; }
.typing { display: flex; gap: 10rpx; padding: 8rpx 0; }
.typing text { width: 12rpx; height: 12rpx; border-radius: 9999rpx; background: var(--ca-muted); animation: caBlink 1.2s infinite; }
.typing text:nth-child(2) { animation-delay: 0.2s; }
.typing text:nth-child(3) { animation-delay: 0.4s; }
@keyframes caBlink { 0%, 60%, 100% { opacity: 0.3; } 30% { opacity: 1; } }
