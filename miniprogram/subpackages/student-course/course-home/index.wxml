<view class="page">
  <block wx:if="{{loading}}">
    <view class="card"><view class="skeleton skeleton-line" style="width:60%"></view><view class="skeleton skeleton-line"></view></view>
  </block>

  <block wx:elif="{{home}}">
    <!-- 课程横幅 -->
    <view class="banner banner--student fade-in">
      <view class="h2" style="color:#fff">{{home.course.name}}</view>
      <view class="text-sub" style="color:rgba(255,255,255,0.85);margin-top:8rpx">{{home.teacher.nickname || '教师'}} · {{home.course.term}}</view>
      <view class="row gap-24 mt-16">
        <text style="color:#fff;font-size:26rpx">完成率 {{home.stats.completion_rate}}%</text>
        <text style="color:#fff;font-size:26rpx">{{home.student_count}} 名同学</text>
      </view>
    </view>

    <!-- 快捷入口 2x2 -->
    <view class="quick-grid">
      <view class="quick" bindtap="goLessons"><text class="quick__icon">▶</text><text>课时学习</text></view>
      <view class="quick" bindtap="goQa"><text class="quick__icon">✦</text><text>AI 问答</text></view>
      <view class="quick" bindtap="goMaterials"><text class="quick__icon">▤</text><text>课程资料</text></view>
      <view class="quick" bindtap="goQuizzes"><text class="quick__icon">✎</text><text>章节练习</text></view>
    </view>

    <!-- 课时列表 -->
    <view class="row-between">
      <view class="section-title" style="margin:0">课时列表</view>
      <text wx:if="{{home.lessons.length > 5}}" class="text-student" style="font-size:26rpx" bindtap="toggleLessons">{{expandLessons ? '收起' : '展开全部'}}</text>
    </view>
    <view class="card" wx:if="{{lessonsShown.length}}">
      <view wx:for="{{lessonsShown}}" wx:key="id" class="lesson-row" data-id="{{item.id}}" bindtap="openLesson">
        <view class="lesson-row__idx num">{{index + 1}}</view>
        <view class="flex-1">
          <view class="ellipsis">{{item.title}}</view>
          <view class="progress mt-8" style="width:200rpx"><view class="progress__bar" style="width:{{item.progress_percent}}%"></view></view>
        </view>
        <text class="text-muted">{{item.progress_percent > 0 ? item.progress_percent + '%' : '未学'}}</text>
      </view>
    </view>
    <view wx:else class="empty"><view class="empty__text">暂无已发布课时</view></view>

    <!-- 我的数据 -->
    <view class="section-title">我的数据</view>
    <view class="stats-grid">
      <view class="stat-card"><view class="stat-card__value num">{{home.stats.study_hours}}</view><view class="stat-card__label">学习时长(h)</view></view>
      <view class="stat-card"><view class="stat-card__value num">{{home.stats.qa_count}}</view><view class="stat-card__label">问答</view></view>
      <view class="stat-card"><view class="stat-card__value num">{{home.stats.wrong_count}}</view><view class="stat-card__label">错题</view></view>
    </view>

    <!-- 课程资料 -->
    <block wx:if="{{home.materials.length}}">
      <view class="row-between">
        <view class="section-title" style="margin:0">课程资料</view>
        <text class="text-student" style="font-size:26rpx" bindtap="goMaterials">更多</text>
      </view>
      <view class="card">
        <view wx:for="{{home.materials}}" wx:key="id" wx:if="{{index < 3}}" class="mat-row">
          <text class="mat-row__icon">📄</text>
          <text class="flex-1 ellipsis">{{item.title}}</text>
          <text class="text-muted" style="font-size:24rpx">{{item.category}}</text>
        </view>
      </view>
    </block>

    <!-- 最近提问 -->
    <block wx:if="{{home.recent_qa.length}}">
      <view class="section-title">最近提问</view>
      <view class="card">
        <view wx:for="{{home.recent_qa}}" wx:key="index" wx:if="{{index < 3}}" class="qa-row">
          <text class="tag tag--ai" style="flex-shrink:0">Q</text>
          <text class="flex-1 ellipsis">{{item.question}}</text>
        </view>
      </view>
    </block>
  </block>
</view>
