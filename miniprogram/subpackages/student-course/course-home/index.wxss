.quick-grid { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 24rpx; }
.quick {
  flex: 1 1 calc(50% - 20rpx); min-width: calc(50% - 20rpx);
  display: flex; align-items: center; gap: 16rpx;
  background: var(--ca-card); border: 1rpx solid var(--ca-border);
  border-radius: 16rpx; padding: 28rpx; font-size: 30rpx; font-weight: 500;
  box-shadow: var(--ca-shadow-card);
}
.quick__icon {
  width: 64rpx; height: 64rpx; border-radius: 14rpx;
  background: var(--ca-student-light); color: var(--ca-student-hover);
  display: flex; align-items: center; justify-content: center; font-size: 32rpx;
}

.lesson-row { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--ca-border); }
.lesson-row:last-child { border-bottom: none; }
.lesson-row__idx { width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; border-radius: 9999rpx; background: var(--ca-bg); color: var(--ca-sub); font-size: 26rpx; flex-shrink: 0; }

.mat-row, .qa-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--ca-border); font-size: 28rpx; }
.mat-row:last-child, .qa-row:last-child { border-bottom: none; }
.mat-row__icon { font-size: 32rpx; }
