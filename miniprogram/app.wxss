/* ===== 智学黑板 · 设计令牌（来自 UI.md / tokens.css） ===== */
page {
  /* 黑板暗底 */
  --ca-slate: #121614;
  --ca-chalk: #F4F4F0;
  --ca-dust: #8C948F;
  /* 学生主色 */
  --ca-student: #00B8D4;
  --ca-student-hover: #0097A7;
  --ca-student-light: #E0F7FA;
  --ca-student-glow: #00E5FF;
  /* 教师主色 */
  --ca-teacher: #D94925;
  --ca-teacher-light: #FBE9E7;
  /* 纸张体系 */
  --ca-bg: #F9F8F6;
  --ca-card: #FFFFFF;
  --ca-border: #E6E4DD;
  --ca-ink: #2C2B29;
  --ca-ink-soft: #444440;
  --ca-sub: #666560;
  --ca-muted: #999990;
  --ca-accent: #C23A22;
  /* 语义色 */
  --ca-success: #2E7D32;
  --ca-success-bg: #E8F5E9;
  --ca-warning: #E65100;
  --ca-warning-bg: #FFF3E0;
  --ca-error: #C62828;
  --ca-error-bg: #FFEBEE;
  --ca-info: #0277BD;
  --ca-info-bg: #E1F5FE;

  /* 阴影 */
  --ca-shadow-card: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  --ca-shadow-sheet: 0 -12rpx 40rpx rgba(18, 22, 20, 0.10);

  background: var(--ca-bg);
  color: var(--ca-ink);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.55;
}

view, text, scroll-view, button, input, textarea, navigator {
  box-sizing: border-box;
}

/* ===== 通用容器 ===== */
.page {
  min-height: 100vh;
  padding: 24rpx 32rpx;
}
.page--tab {
  /* 为底部自定义 TabBar 留白：高度 112rpx + 安全区 + 间距 */
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom) + 24rpx);
}
.page--sheet-pad {
  padding-bottom: 200rpx;
}

/* ===== 卡片 ===== */
.card {
  background: var(--ca-card);
  border: 1rpx solid var(--ca-border);
  border-radius: 16rpx;
  box-shadow: var(--ca-shadow-card);
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.card--flat { box-shadow: none; }

/* ===== 文字 ===== */
.h1 { font-size: 46rpx; font-weight: 700; color: var(--ca-ink); }
.h2 { font-size: 38rpx; font-weight: 600; color: var(--ca-ink); }
.section-title { font-size: 34rpx; font-weight: 600; color: var(--ca-ink); margin: 8rpx 0 16rpx; }
.text-body { font-size: 30rpx; color: var(--ca-ink-soft); }
.text-sub { font-size: 26rpx; color: var(--ca-sub); }
.text-muted { font-size: 26rpx; color: var(--ca-muted); }
.text-accent { color: var(--ca-accent); }
.text-student { color: var(--ca-student); }
.text-teacher { color: var(--ca-teacher); }
.num { font-family: "SFMono-Regular", "Menlo", monospace; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.clamp-2 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.clamp-4 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden; }

/* ===== 布局工具 ===== */
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.wrap { flex-wrap: wrap; }
.gap-8 { gap: 8rpx; }
.gap-16 { gap: 16rpx; }
.gap-24 { gap: 24rpx; }
.flex-1 { flex: 1; min-width: 0; }
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-16 { margin-bottom: 16rpx; }

/* ===== 按钮 ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1;
  border: none;
  transition: transform 0.12s ease;
}
.btn::after { border: none; }
.btn:active { transform: scale(0.98); }
.btn--block { display: flex; width: 100%; }
.btn--md { height: 76rpx; font-size: 28rpx; }
.btn--sm { height: 60rpx; padding: 0 24rpx; font-size: 26rpx; border-radius: 10rpx; }
.btn--primary { background: var(--ca-student); color: #fff; }
.btn--teacher { background: var(--ca-teacher); color: #fff; }
.btn--ghost { background: transparent; color: var(--ca-student); }
.btn--outline { background: var(--ca-card); color: var(--ca-ink-soft); border: 1rpx solid var(--ca-border); }
.btn--danger { background: var(--ca-error); color: #fff; }
.btn[disabled] { opacity: 0.5; }

/* ===== 标签 / 徽标 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  line-height: 1;
}
.tag--ai { background: var(--ca-student-light); color: var(--ca-student-hover); }
.tag--success { background: var(--ca-success-bg); color: var(--ca-success); }
.tag--warning { background: var(--ca-warning-bg); color: var(--ca-warning); }
.tag--error { background: var(--ca-error-bg); color: var(--ca-error); }
.tag--info { background: var(--ca-info-bg); color: var(--ca-info); }
.tag--code { background: #EFEEE9; color: var(--ca-sub); font-family: "SFMono-Regular", "Menlo", monospace; letter-spacing: 1rpx; }

/* ===== 进度条 ===== */
.progress { height: 12rpx; border-radius: 9999rpx; background: var(--ca-border); overflow: hidden; }
.progress__bar { height: 100%; border-radius: 9999rpx; background: var(--ca-student); }
.progress__bar--teacher { background: var(--ca-teacher); }

/* ===== 输入 ===== */
.field { margin-bottom: 24rpx; }
.field__label { font-size: 26rpx; color: var(--ca-sub); margin-bottom: 12rpx; }
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: var(--ca-card);
  border: 1rpx solid var(--ca-border);
  border-radius: 8rpx;
  font-size: 30rpx;
  color: var(--ca-ink);
}
.input--error { border-color: var(--ca-accent); }
.field__error { font-size: 24rpx; color: var(--ca-accent); margin-top: 8rpx; }
.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx 24rpx;
  background: var(--ca-card);
  border: 1rpx solid var(--ca-border);
  border-radius: 12rpx;
  font-size: 30rpx;
}
.search {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 28rpx;
  background: var(--ca-card);
  border: 1rpx solid var(--ca-border);
  border-radius: 9999rpx;
}
.search__input { flex: 1; font-size: 28rpx; }

/* ===== 全局按压态（小程序无 :hover，可点元素统一用 hover-class 引用） ===== */
.hover-dim { opacity: 0.6; }
.hover-bg { background: #F1F0EB !important; }
.hover-card { opacity: 0.85; transform: scale(0.99); }

/* ===== 分隔线 ===== */
.divider { height: 1rpx; background: var(--ca-border); margin: 24rpx 0; }

/* ===== 头像 ===== */
.avatar { border-radius: 9999rpx; background: var(--ca-student-light); overflow: hidden; }

/* ===== 空状态 ===== */
.empty { padding: 80rpx 32rpx; text-align: center; color: var(--ca-muted); }
.empty__icon { font-size: 64rpx; margin-bottom: 16rpx; }
.empty__text { font-size: 28rpx; color: var(--ca-sub); margin-bottom: 24rpx; }

/* ===== 骨架屏 ===== */
.skeleton { background: linear-gradient(90deg, #efeee9 25%, #f6f5f1 37%, #efeee9 63%); border-radius: 12rpx; }
.skeleton-line { height: 28rpx; margin-bottom: 16rpx; }

/* ===== 进入动画 ===== */
.fade-in { animation: caFadeIn 0.22s ease; }
@keyframes caFadeIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 课程横幅（黑板暗底） ===== */
.banner {
  border-radius: 24rpx;
  padding: 32rpx;
  color: var(--ca-chalk);
  background: linear-gradient(135deg, #1a1f1c 0%, #121614 100%);
  position: relative;
  overflow: hidden;
}
.banner--student { background: linear-gradient(135deg, #0097A7 0%, #006978 100%); }
.banner--teacher { background: linear-gradient(135deg, #c2391d 0%, #8f2a16 100%); }

/* ===== 底部抽屉 ===== */
.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(18, 22, 20, 0.45);
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: var(--ca-card);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: var(--ca-shadow-sheet);
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  max-height: 86vh;
  animation: caSheetUp 0.26s ease;
}
.sheet__handle { width: 72rpx; height: 8rpx; border-radius: 9999rpx; background: var(--ca-border); margin: 8rpx auto 20rpx; }
.sheet__title { font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
/* Tab 页上的抽屉：底部额外避让自定义 TabBar（112rpx + 安全区），避免按钮/内容被底部导航栏遮挡 */
.sheet--tab { padding-bottom: calc(112rpx + env(safe-area-inset-bottom) + 32rpx); }
@keyframes caSheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* ===== Chips 横向筛选 ===== */
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 8rpx; }
.chip {
  height: 60rpx;
  line-height: 58rpx;
  padding: 0 28rpx;
  border-radius: 9999rpx;
  background: var(--ca-card);
  border: 1rpx solid var(--ca-border);
  font-size: 26rpx;
  color: var(--ca-sub);
}
.chip--on { background: var(--ca-student-light); border-color: var(--ca-student); color: var(--ca-student-hover); font-weight: 600; }
.chip--teacher.chip--on { background: var(--ca-teacher-light); border-color: var(--ca-teacher); color: var(--ca-teacher); }
.search__icon { font-size: 28rpx; margin-right: 12rpx; opacity: 0.6; }

/* ===== 等宽课程码输入 ===== */
.code-input {
  text-align: center;
  letter-spacing: 8rpx;
  font-size: 44rpx;
  font-family: "SFMono-Regular", "Menlo", monospace;
  text-transform: uppercase;
  height: 100rpx;
}

/* ===== 课程选择胶囊（多页复用） ===== */
.course-sel {
  display: flex;
  align-items: center;
  max-width: 380rpx;
  height: 64rpx;
  padding: 0 24rpx;
  background: var(--ca-student-light);
  color: var(--ca-student-hover);
  border-radius: 9999rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.course-sel__arrow { margin-left: 8rpx; flex-shrink: 0; }
.course-sel--teacher { background: var(--ca-teacher-light); color: var(--ca-teacher); }

/* ===== 统计横幅（4 格，多页复用） ===== */
.stat-banner { display: flex; }
.stat-banner__cell { flex: 1; text-align: center; }
.stat-banner__num { font-size: 44rpx; font-weight: 700; }
.stat-banner__lbl { font-size: 22rpx; opacity: 0.85; margin-top: 4rpx; }
.pick-row { display: flex; align-items: center; padding: 24rpx 16rpx; border-bottom: 1rpx solid var(--ca-border); font-size: 30rpx; }
.pick-row--on { color: var(--ca-student-hover); }

/* ===== 分段 Tab（资料/档案/设置等） ===== */
.seg-tabs { display: flex; background: var(--ca-card); border: 1rpx solid var(--ca-border); border-radius: 12rpx; padding: 6rpx; margin-bottom: 24rpx; }
.seg-tabs__item { flex: 1; text-align: center; height: 64rpx; line-height: 64rpx; font-size: 28rpx; color: var(--ca-sub); border-radius: 9rpx; }
.seg-tabs__item--on { background: var(--ca-student-light); color: var(--ca-student-hover); font-weight: 600; }
.seg-tabs--teacher .seg-tabs__item--on { background: var(--ca-teacher-light); color: var(--ca-teacher); }

/* ===== 通知开关行 / 链接行 ===== */
.notice-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--ca-border); font-size: 30rpx; }
.notice-row:last-child { border-bottom: none; }
.list-link { display: flex; align-items: center; padding: 24rpx 0; font-size: 30rpx; }

/* ===== 时间线 ===== */
.timeline { display: flex; gap: 20rpx; padding: 16rpx 0; }
.timeline__dot { width: 16rpx; height: 16rpx; border-radius: 9999rpx; background: var(--ca-student); margin-top: 10rpx; flex-shrink: 0; }

/* ===== 指标网格（多页复用） ===== */
.stats-grid { display: flex; gap: 20rpx; margin-bottom: 8rpx; }
.stat-card { flex: 1; background: var(--ca-card); border: 1rpx solid var(--ca-border); border-radius: 16rpx; padding: 28rpx 16rpx; text-align: center; box-shadow: var(--ca-shadow-card); }
.stat-card__value { font-size: 48rpx; font-weight: 700; color: var(--ca-student-hover); }
.stat-card__unit { font-size: 26rpx; margin-left: 4rpx; }
.stat-card__label { font-size: 24rpx; color: var(--ca-sub); margin-top: 8rpx; }

/* ===== 问候横幅（首页复用） ===== */
.hero { margin-bottom: 24rpx; }
.hero__greeting { font-size: 42rpx; font-weight: 700; }
.hero__sub { font-size: 26rpx; opacity: 0.85; margin-top: 8rpx; }

/* ===== 教师统计 2x2 / 列表行 ===== */
.t-stats { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 8rpx; }
.t-stat { flex: 1 1 calc(50% - 20rpx); min-width: calc(50% - 20rpx); background: var(--ca-card); border: 1rpx solid var(--ca-border); border-radius: 16rpx; padding: 28rpx; box-shadow: var(--ca-shadow-card); }
.t-stat__num { font-size: 52rpx; font-weight: 700; color: var(--ca-ink); }
.t-stat__label { font-size: 24rpx; color: var(--ca-sub); margin-top: 8rpx; }
.t-course-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--ca-border); }
.t-course-row:last-child { border-bottom: none; }
.todo-row { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--ca-border); font-size: 28rpx; }
.todo-row:last-child { border-bottom: none; }
.todo-row__dot { width: 16rpx; height: 16rpx; border-radius: 9999rpx; background: var(--ca-teacher); flex-shrink: 0; }
.todo-row__dot--error { background: var(--ca-error); }
.todo-row__dot--lesson { background: var(--ca-warning); }

/* ===== 身份卡（个人中心复用） ===== */
.id-card { margin-bottom: 24rpx; }
.id-card__avatar {
  width: 120rpx; height: 120rpx; border-radius: 9999rpx;
  background: rgba(255,255,255,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; font-weight: 700; color: #fff; overflow: hidden; flex-shrink: 0;
}
.id-card__avatar-img { width: 100%; height: 100%; }
.id-card__name { font-size: 38rpx; font-weight: 700; }
.id-card__meta { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; }
