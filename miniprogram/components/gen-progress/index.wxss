/* 右下角出题进度浮层。bottom 预留底部 TabBar 高度，错题本(Tab 页)与子包页通用 */
.genp {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 300;
  background: #ffffff;
  border: 1rpx solid #e6e4dd;
  border-left: 6rpx solid #00b8d4;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 40rpx rgba(18, 22, 20, 0.14);
  padding: 20rpx 24rpx;
  animation: genpUp 0.24s ease;
}
.genp--fail { border-left-color: #c62828; }
@keyframes genpUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.genp__head { display: flex; align-items: center; gap: 12rpx; }
.genp__title {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #2c2b29;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.genp__close {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999990;
  font-size: 26rpx;
}

.genp__steps { margin-top: 18rpx; display: flex; flex-direction: column; gap: 14rpx; }
.genp-step { display: flex; align-items: center; gap: 14rpx; font-size: 24rpx; color: #999990; }
.genp-step--done { color: #2e7d32; }
.genp-step--active { color: #2c2b29; font-weight: 600; }
.genp-step__label { flex: 1; min-width: 0; }
.genp-step__mark { flex: 0 0 auto; width: 30rpx; height: 30rpx; display: flex; align-items: center; justify-content: center; }
.genp-check { color: #2e7d32; font-size: 28rpx; font-weight: 700; }
.genp-dot { width: 14rpx; height: 14rpx; border-radius: 9999rpx; border: 2rpx solid #d8d6cf; }
.genp-spin {
  width: 26rpx;
  height: 26rpx;
  border-radius: 9999rpx;
  border: 4rpx solid #cfeef4;
  border-top-color: #00b8d4;
  animation: genpSpin 0.7s linear infinite;
}
@keyframes genpSpin { to { transform: rotate(360deg); } }
.genp__fail { margin-top: 14rpx; font-size: 22rpx; color: #c62828; }
