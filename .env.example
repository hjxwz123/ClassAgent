APP_ENV=development
SECRET_KEY=change-this-secret-key-in-production
DATABASE_URL=mysql+pymysql://class_agent:class_agent_2026@127.0.0.1:3306/class_agent?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=true
EXTERNAL_AI_MODE=auto
EXTERNAL_STORAGE_MODE=auto
EXTERNAL_SERVICE_TIMEOUT_SECONDS=300
MATERIAL_PROCESSING_WORKER_COUNT=4
DOC_PARSER_MAX_CONCURRENCY=2
MATERIAL_AI_MAX_CONCURRENCY=6
KNOWLEDGE_POINT_EXTRACTION_MAX_CONCURRENCY=15
TTS_MAX_CONCURRENCY=1
MATERIAL_PROCESSING_STALE_MINUTES=10
MATERIAL_PROCESSING_WATCHDOG_INTERVAL_SECONDS=30
PUBLIC_BASE_URL=http://127.0.0.1:8000
VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIR=storage/vectors/chroma
QDRANT_URL=http://127.0.0.1:6333
# Without a standalone Qdrant service, use a local embedded store:
# QDRANT_URL=local:storage/vectors/qdrant
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=classagent
QDRANT_TIMEOUT_SECONDS=10
EMBEDDING_DIMENSION=1536
ADMIN_DEFAULT_EMAIL=admin@classagent.com
ADMIN_DEFAULT_PASSWORD=Admin123456
ADMIN_DEFAULT_NAME=系统管理员
